#!/bin/sh
# ADR 0023 GIT_ASKPASS helper. Shipped in the fleet-wide `skills` RO
# bundle (ADR 0027); /etc/gitconfig (written by agentd for forge sessions)
# points `core.askPass` at this path.
#
# git invokes this with the prompt string as $1. The username half returns
# the fixed `x-access-token` (also set via credential.<host>.username, so
# this branch is belt-and-suspenders); the password half asks the engrams
# host for a fresh, short-lived credential over the forge vsock bridge.
# The real token never persists in the guest.
case "$1" in
    *[Uu]sername*) printf 'x-access-token' ;;
    *)
        # ADR 0056 P2: parse the git host out of git's prompt (e.g.
        # "Password for 'https://x-access-token@github.com': " → github.com) so the
        # forge bridge mints for the right git-forge provider — no hardcoded host.
        # Falls back to github.com if the prompt can't be parsed.
        host=$(printf '%s' "$1" | sed -n 's|.*@\([a-zA-Z0-9.-]*\).*|\1|p')
        exec engram-agentd forge-credential --host "${host:-github.com}"
        ;;
esac
