#!/bin/sh
# ADR 0064 browser bundle launcher. Self-contained, glibc-linked; runs on any
# glibc base. ADR 0055: mounts at a dynamic slot (/opt/engram/dyn/<i>) and
# agentd symlinks this onto PATH, so resolve our real bundle root from $0
# (readlink -f follows the PATH symlink) — never a fixed mount path.
#
# Brings up, in order: Xvfb (virtual display :99) → openbox (focus/maximize,
# no panel/menu) → x11vnc (RFB on 127.0.0.1:5900) → chromium (full UI, sized to
# the framebuffer). No desktop/file-manager/terminal — the framebuffer shows
# only Chrome. setsid puts the whole stack in its own process group so agentd
# can reap it as a unit (StopBrowser → killpg).
set -eu
here="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"

export LD_LIBRARY_PATH="$here/lib:${LD_LIBRARY_PATH:-}"
export FONTCONFIG_FILE="$here/fonts.conf"
export PATH="$here/bin:$PATH"

DISPLAY_NUM="${ENGRAM_BROWSER_DISPLAY:-99}"
export DISPLAY=":$DISPLAY_NUM"
GEOMETRY="${ENGRAM_BROWSER_GEOMETRY:-1280x800x24}"
VNC_PORT="${ENGRAM_BROWSER_VNC_PORT:-5900}"
PROFILE_DIR="$(mktemp -d /tmp/engram-browser-profile.XXXXXX)"

cleanup() {
    # Disarm first: `kill 0` signals the WHOLE process group — including this
    # shell — so without clearing the traps the delivered TERM/INT re-enters
    # cleanup and recurses until the shell aborts ("Maximum function recursion
    # depth reached"). Clear, then kill the group (Xvfb/openbox/chromium).
    trap - TERM INT EXIT
    kill 0 2>/dev/null || true
}
trap cleanup TERM INT EXIT

# Xvfb compiles its keymap at startup by exec'ing a HARD-CODED /usr/bin/xkbcomp
# (the X server's compiled-in path; -xkbdir relocates only the DATA, not the
# binary). A minimal glibc base need not ship xkbcomp, so point that path at the
# bundled one. Idempotent; the per-session guest rootfs is writable + ephemeral.
ln -sf "$here/bin/xkbcomp" /usr/bin/xkbcomp 2>/dev/null || true

# 1) Virtual X display. +extension RANDR enables x11vnc -xrandr live resize.
# -xkbdir points the server at the bundle's relocated XKB data (build.sh copies
# /usr/share/X11/xkb -> $here/share/X11/xkb); without it the server can't
# compile a keymap and aborts before any client can connect.
"$here/bin/Xvfb" "$DISPLAY" -screen 0 "$GEOMETRY" +extension RANDR -nolisten tcp \
    -xkbdir "$here/share/X11/xkb" &
# Wait for the X socket before starting clients.
for _ in $(seq 1 100); do
    [ -S "/tmp/.X11-unix/X$DISPLAY_NUM" ] && break
    sleep 0.05
done

# 2) Minimal WM so chromium gets focus + maximizes. No root menu / no panel.
"$here/bin/openbox" &

# 3) Chromium under a respawn supervisor. Full UI, sized to the framebuffer, no
# first-run prompts. The VM is the isolation boundary, so --no-sandbox. Renderer
# shm uses the guest's real /dev/shm (engram-init mounts it), so we do NOT
# disable dev-shm.
#
# Why supervised: the framebuffer shows ONLY chrome, so if the user closes the
# last tab (chromium exits) or chrome crashes, a one-shot launch would strand
# the VNC tab on the empty openbox desktop with no way back — and agentd can't
# recover it either, because x11vnc is still up and its port still accepts, so
# the next StartBrowser re-probes green and never respawns. So relaunch chrome
# here whenever it exits, reusing the same profile (tabs/cookies survive) and
# without disturbing x11vnc or the live VNC connection. Clear the inherited
# cleanup trap in the subshell so a group SIGTERM (StopBrowser killpg) just
# terminates it cleanly instead of re-entering `kill 0`.
(
    trap - TERM INT EXIT
    while true; do
        # A crash can leave a stale singleton lock that blocks relaunch with
        # "profile appears to be in use"; the profile is single-tenant and
        # ephemeral, so clear it before each (re)launch.
        rm -f "$PROFILE_DIR"/Singleton* 2>/dev/null || true
        "$here/chrome/chrome" \
            --user-data-dir="$PROFILE_DIR" \
            --no-sandbox \
            --no-first-run --no-default-browser-check \
            --disable-infobars \
            --start-maximized \
            --window-position=0,0 \
            "${ENGRAM_BROWSER_HOMEPAGE:-about:blank}" || true
        # chrome exited; pause so a hard launch failure can't hot-loop, then
        # bring it back up on the same display.
        sleep 1
    done
) &

# 4) x11vnc last (so the display + a client window exist). It MUST bind all
# interfaces (x11vnc's default) — NOT loopback. The host-agent's proxy_vnc dials
# the VM's routable IP (vm_internal_ip, e.g. 192.168.64.2:5900) from OUTSIDE the
# guest, exactly like the shell's ttyd which binds 0.0.0.0:7681. `-localhost`
# binds 127.0.0.1 only, so the host's dial to guest_ip:5900 is refused, no RFB
# bytes ever flow, and the VNC tab shows "connection closed unexpectedly". The
# per-VM network is the isolation boundary (prod FC: a per-VM netns reachable
# only by the host-agent; VZ dev: the same vmnet posture ttyd already relies on),
# so binding all interfaces here matches the shell rather than widening exposure.
# -forever: survive client disconnects (refresh grace handled host-side).
# -xrandr: track RANDR resolution changes for noVNC remote resize (x11vnc's flag
# is -xrandr, NOT -randr — an unrecognized option makes x11vnc abort before
# binding the RFB port). exec so this process becomes x11vnc; agentd reaps the
# whole group via killpg, and x11vnc handles its own signals (the shell trap
# above only covers the pre-exec bring-up).
exec "$here/bin/x11vnc" \
    -display "$DISPLAY" \
    -rfbport "$VNC_PORT" \
    -forever -shared -noxdamage -nopw -quiet -xrandr
