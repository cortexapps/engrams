#!/bin/sh
# ADR 0065 browser bundle launcher. Self-contained, glibc-linked; runs on any
# glibc base — issue #569: NOT via LD_LIBRARY_PATH (the kernel always execs
# the loader baked into each binary's PT_INTERP, so that only steers a loader
# that is already running the base image's own), but because build.sh
# patchelf's every bundled binary to carry its own interpreter + rpath. See
# the BUNDLE_LINK block a few lines down for the run-time half of that fix.
# ADR 0055: mounts at a dynamic slot (/opt/engram/dyn/<i>) and agentd
# symlinks this onto PATH, so resolve our real bundle root from $0
# (readlink -f follows the PATH symlink) — never a fixed mount path.
#
# Brings up, in order: Xvfb (virtual display :99) → openbox (focus/maximize,
# no panel/menu) → a chromium respawn loop (full UI, sized to the framebuffer)
# → x11vnc (RFB on 127.0.0.1:5900, reached over the ADR-0066 proxy_vnc). No
# desktop/file-manager/terminal — the framebuffer shows only Chrome. The whole
# stack shares one process group so agentd can reap it as a unit
# (StopBrowser → killpg). Issue #569: only chromium used to be supervised —
# Xvfb/x11vnc dying left the chrome loop spinning against a dead display with
# nothing to notice or clean up. Xvfb and x11vnc now each run under a
# supervisor subshell that tears down the whole group the instant its daemon
# exits (openbox is cosmetic, not watched); agentd's
# force-stop-on-failed-RFB-probe (#568) makes "kill everything and let the
# next StartBrowser rebuild" the right recovery.
#
# Security (ADR 0065 §7): the human points this browser at arbitrary, untrusted
# sites, so the stack runs UNPRIVILEGED with chromium's sandbox ON. The script
# starts as root only long enough for the few root-only steps (the xkbcomp
# symlink; the unprivileged uid's $HOME + /etc/passwd entry), then re-exec's
# itself via setpriv as a non-root, capless uid that holds none of the
# session's secrets.
set -eu
here="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"
self="$(readlink -f -- "$0")"

# --- Stable bundle path for the patchelf'd binaries (issue #569) ------------
# build.sh patches every bundled ELF's PT_INTERP + DT_RPATH to the fixed
# absolute path /tmp/engram-browser-bundle/lib, baked in at BUILD time — the
# kernel always execs the interpreter recorded in the ELF, so this can't be
# steered via LD_LIBRARY_PATH at run time (see build.sh's header for why the
# old LD_LIBRARY_PATH-only approach broke on any base image whose glibc
# differs from the bookworm build stage). But bundles mount at a dynamic
# reserved slot (/opt/engram/dyn/<i>, ADR 0055) that is not known until this
# script runs, so the baked-in path can't point there directly. Bridge the
# two here: keep a stable symlink at that fixed path pointing at $here,
# created/refreshed before ANY bundled binary can run — including the node
# probe inside stack_up() below, which the --ensure fast path reaches before
# anything else in the script.
#
# No env override is possible here (an ENGRAM_BROWSER_BUNDLE_LINK knob would
# be meaningless): the path is compiled into the ELFs themselves at build
# time, not read from the environment at run time, so both sides must agree
# on the literal string.
#
# /tmp is the right home: the guest is single-tenant (same rationale as
# BROWSER_PIDFILE below), and it must work for non-root too — the dev
# ProcessBackend stages this same bundle unpacked and runs the launcher as a
# regular user with no /opt write access. If the symlink can't be pointed at
# $here (e.g. sticky-bit /tmp, or an existing entry owned by another uid),
# fail loudly rather than let every bundled binary silently run against a
# stale bundle's libs — that would be a subtle heisenbug.
BUNDLE_LINK=/tmp/engram-browser-bundle
if [ "$(readlink -- "$BUNDLE_LINK" 2>/dev/null)" != "$here" ]; then
    ln -sfn "$here" "$BUNDLE_LINK" 2>/dev/null || {
        echo "engram-browser: cannot point $BUNDLE_LINK at $here (stale symlink owned by another uid, or /tmp not writable?)" >&2
        exit 1
    }
fi

# No LD_LIBRARY_PATH: the patched binaries above find lib/ via their own
# DT_RPATH through BUNDLE_LINK; system utilities this script also shells out
# to (sh, sleep, seq, mktemp, grep, date, mount, ...) must keep running
# against the base image's OWN libc, which a global LD_LIBRARY_PATH used to
# poison (issue #569 — e.g. /bin/sh re-execs and `timeout` crashed on
# glibc-mismatched bases even though the browser stack itself never touches
# them).
export FONTCONFIG_FILE="$here/fonts.conf"
export PATH="$here/bin:$PATH"

# --- Lazy, idempotent bring-up + agentd "registration" (ADR 0065) -----------
# ONE shared stack serves both audiences: the human (agentd StartBrowser) and
# the agent (the bundled playwright-cli wrapper runs `engram-browser --ensure`
# before connecting to CDP). `--ensure` is idempotent — x11vnc already serving
# means the stack is up — and flock-guarded so the two triggers can't
# double-spawn. The stack runs DETACHED in its own process group; its pgid is
# recorded in a pidfile, and agentd reaps THAT at snapshot/idle teardown (it
# need not be the spawner). The pidfile IS the registration — no control verb.
ENSURE_VNC_PORT="${ENGRAM_BROWSER_VNC_PORT:-5900}"
# World-accessible tmp path: written by whoever runs --ensure (the agent's uid
# or, on the human path, agentd as root) and read by agentd (root) to reap. The
# guest is single-tenant (the VM is the isolation boundary), so a fixed path is
# safe; override via ENGRAM_BROWSER_PIDFILE.
BROWSER_PIDFILE="${ENGRAM_BROWSER_PIDFILE:-/tmp/engram-browser.pgid}"
# Bring-up log for the stack itself (Xvfb/openbox/x11vnc stdout+stderr) and a
# separate log for chrome's respawn loop (below) — issue #569: --ensure-locked
# used to redirect the whole detached stack to /dev/null, so a startup failure
# (e.g. chromium's sandbox init) left no trace anywhere. Both are truncated on
# each bring-up/(re)launch so they stay small and always hold the latest run.
BROWSER_LOG="${ENGRAM_BROWSER_LOG:-/tmp/engram-browser.log}"
CHROME_LOG="${ENGRAM_BROWSER_CHROME_LOG:-/tmp/engram-browser.chrome.log}"

# Is the stack up? Probe x11vnc's RFB port (:5900) via the bundled node (shipped
# for playwright-cli, so the launcher needs no curl/nc). We gate on RFB, NOT
# chromium's CDP (:9222): x11vnc is the LAST thing the launcher starts, so RFB
# accepting means the whole stack is up — and chromium's DevTools socket lags,
# so gating on it made the spawn flaky (the agent's connectOverCDP retries CDP
# itself). A bare connect is NOT enough (issue #567): a VM snapshot/restore can
# resurrect a WEDGED x11vnc whose listen socket still accepts but never sends
# the RFB ProtocolVersion banner — a bare connect passes that wedge, --ensure
# concludes "already up" and no-ops, and the agent's playwright-cli path (which
# never goes through agentd's banner probe) stays stuck until the VM is
# recreated. So require the 12-byte banner ("RFB 003.008\n" — sent immediately
# on accept, though not necessarily in one segment) within an overall 2s
# deadline from connect (mirroring agentd's RFB_BANNER_TIMEOUT), so a silent
# wedge fails in bounded time instead of hanging the ensure.
stack_up() {
    "$here/node/bin/node" -e '
        const s = require("net").connect(+process.argv[1], "127.0.0.1");
        const done = (code) => { s.destroy(); process.exit(code); };
        setTimeout(() => done(1), 2000);      // one connect+banner deadline
        let buf = Buffer.alloc(0);
        s.on("data", (d) => {
            buf = Buffer.concat([buf, d]);
            if (buf.length >= 12)
                done(buf.slice(0, 4).toString("latin1") === "RFB " ? 0 : 1);
        });
        s.on("error", () => done(1));
        s.on("close", () => done(1));         // hung up before a full banner
    ' "$ENSURE_VNC_PORT" 2>/dev/null
}

if [ "${1:-}" = "--ensure" ]; then
    stack_up && exit 0                      # fast path: already up
    mkdir -p "$(dirname "$BROWSER_PIDFILE")" 2>/dev/null || true
    # Serialize concurrent ensures (human opens the tab while the agent calls
    # playwright-cli) so exactly one brings the stack up. flock ships in the
    # bundle (util-linux, alongside setpriv); fall back to unlocked if absent.
    FLOCK=""
    [ -x "$here/bin/flock" ] && FLOCK="$here/bin/flock"
    [ -z "$FLOCK" ] && command -v flock >/dev/null 2>&1 && FLOCK="$(command -v flock)"
    if [ -n "$FLOCK" ]; then
        exec "$FLOCK" -w 60 "${BROWSER_PIDFILE}.lock" "$self" --ensure-locked
    fi
    exec "$self" --ensure-locked
fi

if [ "${1:-}" = "--ensure-locked" ]; then
    stack_up && exit 0                      # re-check under the lock
    # Bring the stack up detached in a fresh session/pgid (setsid) and record
    # the pgid; when this short-lived --ensure process exits, the stack
    # reparents to PID 1 (agentd), which reaps it by the pidfile at teardown.
    # Capture stdout+stderr to BROWSER_LOG (truncated here, at bring-up) rather
    # than /dev/null — issue #569, this used to throw away Xvfb/openbox/x11vnc
    # startup errors entirely.
    setsid "$self" --run >"$BROWSER_LOG" 2>&1 &
    pgid=$!
    echo "$pgid" > "$BROWSER_PIDFILE"
    # Return only once x11vnc accepts, so callers can connect immediately; bounded
    # so a launch failure can't hang the agent.
    i=0
    while [ "$i" -lt 200 ]; do
        stack_up && exit 0
        kill -0 "$pgid" 2>/dev/null || { echo "engram-browser: stack exited during bring-up" >&2; exit 1; }
        i=$((i + 1)); sleep 0.1
    done
    echo "engram-browser: x11vnc :$ENSURE_VNC_PORT not ready within 20s" >&2
    exit 1
fi

if [ "${1:-}" = "--wait-cdp" ]; then
    # Agent path only (the bundled playwright-cli wrapper calls this after
    # --ensure). --ensure returns on the x11vnc RFB gate (:5900), but chromium
    # binds its CDP endpoint (:9222) a beat later — and playwright-cli
    # connectOverCDP fails fast on that gap (one-shot GET /json/version ->
    # ECONNREFUSED, with no retry of its own), which is the ADR-0065
    # "RFB readiness is necessary-but-not-sufficient" chromium-liveness gap. So
    # block until CDP actually answers a /json/version (HTTP 200) before letting
    # the CLI connect. Bounded (~20s); on timeout exit 0 anyway so the wrapper
    # still execs the CLI and surfaces the real error instead of us swallowing it.
    # The human/VNC path never calls this, so --ensure stays RFB-only (gating it
    # on the laggy CDP socket is what made spawn flaky — ADR 0065).
    CDP_PORT="${ENGRAM_BROWSER_CDP_PORT:-9222}"
    "$here/node/bin/node" -e '
        const http = require("http");
        const port = +process.argv[1];
        const deadline = Date.now() + 20000;
        const retry = () => { if (Date.now() > deadline) process.exit(0); else setTimeout(tick, 200); };
        const tick = () => {
            const req = http.get({ host: "127.0.0.1", port, path: "/json/version", timeout: 1000 }, (res) => {
                res.resume();
                if (res.statusCode === 200) process.exit(0);
                retry();
            });
            req.on("error", retry);
            req.on("timeout", () => { req.destroy(); retry(); });
        };
        tick();
    ' "$CDP_PORT" 2>/dev/null || true
    exit 0
fi

# Default (`--run`, or no arg for dev): the full bring-up below, ending as the
# supervising main shell (parked in `wait` on the Xvfb/x11vnc supervisor
# subshells). Invoked detached by --ensure-locked (or directly on a dev box).

# --- Privilege drop (ADR 0065 §7) -------------------------------------------
# Drop HERE, in the bundle's own launcher, rather than in agentd: the workspace
# is forbid(unsafe_code), so agentd can neither pre_exec a setgroups/setgid/
# setuid sequence nor use the nightly-only CommandExt::groups (safe stable Rust
# can set uid/gid but can NOT clear supplementary groups, which we require); and
# this script is the only actor that knows the bundle's mount path for the
# root-only xkbcomp symlink. setpriv ships inside the bundle, so the guest image
# needs nothing. uid/gid default to a dedicated, collision-unlikely value; the
# control plane may override via ENGRAM_BROWSER_UID/GID.
BROWSER_UID="${ENGRAM_BROWSER_UID:-9000}"
BROWSER_GID="${ENGRAM_BROWSER_GID:-9000}"
BROWSER_USER=engram-browser
BROWSER_HOME=/tmp/engram-browser-home

if [ "$(id -u)" = 0 ]; then
    # Xvfb execs a HARD-CODED /usr/bin/xkbcomp (the X server's compiled-in path;
    # -xkbdir relocates only the DATA, not the binary), and a minimal glibc base
    # need not ship one — point it at the bundled binary. The per-session guest
    # rootfs is writable + ephemeral, so this and the /etc/passwd line below are
    # safe and need no cleanup.
    ln -sf "$here/bin/xkbcomp" /usr/bin/xkbcomp 2>/dev/null || true
    # The X socket dir must exist + be world-writable so the non-root Xvfb can
    # create /tmp/.X11-unix/X$DISPLAY_NUM.
    mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
    # chromium/Xvfb/x11vnc call getpwuid(); give the uid a writable $HOME and a
    # passwd entry so a no-such-user lookup can not surprise the stack at runtime.
    mkdir -p "$BROWSER_HOME"
    chown "$BROWSER_UID:$BROWSER_GID" "$BROWSER_HOME"
    chmod 700 "$BROWSER_HOME"
    if ! grep -q ":x:$BROWSER_UID:" /etc/passwd 2>/dev/null; then
        printf '%s:x:%s:%s::%s:/usr/sbin/nologin\n' \
            "$BROWSER_USER" "$BROWSER_UID" "$BROWSER_GID" "$BROWSER_HOME" >> /etc/passwd
        grep -q ":x:$BROWSER_GID:" /etc/group 2>/dev/null \
            || printf '%s:x:%s:\n' "$BROWSER_USER" "$BROWSER_GID" >> /etc/group
    fi
    # Re-exec the rest as the unprivileged user: real uid+gid, no supplementary
    # groups, no inheritable caps, empty capability bounding set. --clear-groups
    # is exactly the bit safe stable Rust can not express. We deliberately do
    # NOT pass --no-new-privs: it would block chromium's setuid-sandbox fallback
    # on a kernel without unprivileged userns, and the namespace sandbox sets
    # no_new_privs itself anyway.
    exec "$here/bin/setpriv" \
        --reuid="$BROWSER_UID" --regid="$BROWSER_GID" \
        --clear-groups --inh-caps=-all --bounding-set=-all \
        -- "$self" "$@"
fi

# --- everything below runs as the unprivileged engram-browser user ----------
export HOME="$BROWSER_HOME"

DISPLAY_NUM="${ENGRAM_BROWSER_DISPLAY:-99}"
export DISPLAY=":$DISPLAY_NUM"
# Xvfb's framebuffer is FIXED at this size for the VM's lifetime — it can't grow
# past its startup geometry, and in practice Xvfb+x11vnc do NOT honor the noVNC
# client's resize-to-panel request (the framebuffer stays put), so we don't
# depend on dynamic resize. Instead chrome fills this fixed framebuffer
# completely (see --window-size on the chrome launch below), and the noVNC tab
# scales it to fit its panel (scaleViewport). Aspect differences between this
# framebuffer and the panel show up as letterbox bars. Override via
# ENGRAM_BROWSER_GEOMETRY.
GEOMETRY="${ENGRAM_BROWSER_GEOMETRY:-1440x1080x24}"
# Split WxHxDEPTH so chrome can be sized to exactly the framebuffer below — the
# WM maximize hint (--start-maximized) raced/failed, leaving chrome at its
# default ~half-width size with the rest of the framebuffer showing as black
# desktop. An explicit --window-size is deterministic.
FB_W="${GEOMETRY%%x*}"
_geom_rest="${GEOMETRY#*x}"
FB_H="${_geom_rest%%x*}"
VNC_PORT="${ENGRAM_BROWSER_VNC_PORT:-5900}"
# ADR 0065 §1a / ADR 0066 — the SHARED-browser CDP debug port. Chrome exposes
# CDP here so (a) the agent's in-guest playwright-cli drives THIS chrome via
# connectOverCDP(127.0.0.1:9222) and (b) the orchestrator attaches a read-mostly
# metadata client (Target.* tab/URL state for the exposed-ports rail). Bound
# LOOPBACK (chromium's default — we pass no --remote-debugging-address): the
# agent reaches it in-guest directly, and the orchestrator reaches it through the
# ADR 0066 vsock port relay (in-guest agentd dials 127.0.0.1 and splices), so a
# full remote-control protocol is never exposed on the guest network. This is the
# same ADR-0066 posture that lets x11vnc drop to -localhost (retiring the
# original 0.0.0.0 + dial-guest_ip mechanism). --remote-allow-origins='*' still
# clears Chrome >=111's DevTools Origin check (independent of bind address).
# Override port via ENGRAM_BROWSER_CDP_PORT.
CDP_PORT="${ENGRAM_BROWSER_CDP_PORT:-9222}"
PROFILE_DIR="$(mktemp -d /tmp/engram-browser-profile.XXXXXX)"

cleanup() {
    # Disarm first: `kill 0` signals the WHOLE process group — including this
    # shell — so without clearing the traps the delivered TERM/INT re-enters
    # cleanup and recurses until the shell aborts ("Maximum function recursion
    # depth reached"). Clear, then kill the group (Xvfb/openbox/chromium).
    trap - TERM INT EXIT
    kill 0 2>/dev/null || true
}
trap cleanup TERM INT EXIT

# 1) Virtual X display. +extension RANDR enables x11vnc -xrandr live resize.
# -xkbdir points the server at the bundle's relocated XKB data (build.sh copies
# /usr/share/X11/xkb -> $here/share/X11/xkb); without it the server can't
# compile a keymap and aborts before any client can connect.
# Supervised (issue #569 — see the design note above `wait` at the bottom):
# the subshell blocks on Xvfb and tears down the whole group the moment it
# exits. Clear the inherited cleanup trap so a group TERM (a sibling
# supervisor's teardown, or StopBrowser's killpg) just terminates this
# subshell instead of re-entering `kill 0`.
(
    trap - TERM INT EXIT
    # The subshell INHERITS `set -e`, so the `|| true` is load-bearing: without
    # it a crashing daemon's nonzero exit aborts the subshell right here and
    # the teardown kill below never runs (verified empirically).
    "$here/bin/Xvfb" "$DISPLAY" -screen 0 "$GEOMETRY" +extension RANDR -nolisten tcp \
        -xkbdir "$here/share/X11/xkb" || true
    echo "engram-browser: Xvfb died, tearing down the stack" >&2
    kill -TERM 0 2>/dev/null || true
) &
# Wait for the X socket before starting clients. Stays in the MAIN shell (it
# only needs the Xvfb supervisor above to have started first).
for _ in $(seq 1 100); do
    [ -S "/tmp/.X11-unix/X$DISPLAY_NUM" ] && break
    sleep 0.05
done

# 2) Minimal WM so chromium gets focus + maximizes. No root menu / no panel.
# Deliberately UNsupervised: openbox is cosmetic (focus/maximize only), so its
# death shouldn't tear down a working chrome+VNC session.
"$here/bin/openbox" &

# 3) Chromium under a respawn supervisor. Full UI, sized to the framebuffer, no
# first-run prompts. Runs unprivileged with its sandbox ON (see the drop above +
# the chrome flags below). Renderer shm uses the guest's real /dev/shm
# (engram-init mounts it), so we do NOT disable dev-shm.
#
# Why supervised: the framebuffer shows ONLY chrome, so if the user closes the
# last tab (chromium exits) or chrome crashes, a one-shot launch would strand
# the VNC tab on the empty openbox desktop with no way back — and agentd can't
# recover it either, because x11vnc is still up and its port still accepts, so
# the next StartBrowser re-probes green and never respawns. So relaunch chrome
# here whenever it exits, reusing the same profile (tabs/cookies survive) and
# without disturbing x11vnc or the live VNC connection. Clear the inherited
# cleanup trap in the subshell so a group SIGTERM (StopBrowser killpg) just
# terminates it cleanly instead of re-entering `kill 0`.
(
    trap - TERM INT EXIT
    launch=0
    while true; do
        launch=$((launch + 1))
        # A crash can leave a stale singleton lock that blocks relaunch with
        # "profile appears to be in use"; the profile is single-tenant and
        # ephemeral, so clear it before each (re)launch.
        rm -f "$PROFILE_DIR"/Singleton* 2>/dev/null || true
        # Chrome runs with its SANDBOX ON (ADR 0065 §7) — no --no-sandbox. The
        # launcher already dropped to a non-root uid, which is precisely what
        # lets chromium use its namespace (zygote) sandbox, so an exploited
        # renderer is confined. (--test-type is gone too — it only existed to
        # silence the bad-flags warning that --no-sandbox raised.)
        #
        # stdout+stderr go to CHROME_LOG, TRUNCATED per launch (`>`, not `>>`)
        # so the file stays small and always holds the latest attempt — issue
        # #569, this used to be discarded entirely by the --ensure-locked
        # redirect, so a sandbox-init failure left no trace anywhere.
        # --disable-gpu: a microVM has no GPU and Xvfb has no GLX, so the GPU
        # process can only crash-loop (ANGLE "GLX is not present", one dead
        # GPU process after another) before chrome settles on the same
        # software raster path this flag selects directly — measured on a
        # 2-vCPU FC guest, the loop delayed CDP (:9222) by ~70s (issue #569).
        if "$here/chrome/chrome" \
            --user-data-dir="$PROFILE_DIR" \
            --no-first-run --no-default-browser-check \
            --disable-infobars --disable-gpu \
            --remote-debugging-port="$CDP_PORT" \
            --remote-allow-origins='*' \
            --window-position=0,0 \
            --window-size="$FB_W,$FB_H" \
            "${ENGRAM_BROWSER_HOMEPAGE:-about:blank}" >"$CHROME_LOG" 2>&1; then
            rc=0
        else
            rc=$?
        fi
        # Appended (not truncated) so the note survives until the NEXT
        # launch's truncation, i.e. it's still there to explain why the log
        # ends where it does.
        echo "engram-browser: chrome exited status=$rc (launch #$launch)" >>"$CHROME_LOG"
        # chrome exited; pause so a hard launch failure can't hot-loop, then
        # bring it back up on the same display.
        sleep 1
    done
) &

# 4) x11vnc last (so the display + a client window exist). Bind LOOPBACK
# (`-localhost` → 127.0.0.1:5900). ADR 0066 has agentd dial 127.0.0.1:5900
# in-guest and splice RFB over the vsock relay — that's what makes loopback-only
# viable (#498 needed 0.0.0.0 only because the OLD mechanism dialed `guest_ip`
# from outside, and a guest_ip dial can't reach a loopback listener). 0.0.0.0
# would still WORK with the relay; loopback is a least-exposure choice: RFB never
# listens on the guest network, so the only route to it is the auth-gated relay
# (belt to the per-VM-netns suspenders, and it matters more on the less-isolated
# VZ dev network). `lo` must be up — the relay dials 127.0.0.1 regardless of bind.
# -forever: survive client disconnects (refresh grace handled host-side).
# -xrandr: track RANDR resolution changes for noVNC remote resize (x11vnc's flag
# is -xrandr, NOT -randr — an unrecognized option makes x11vnc abort before
# binding the RFB port). Supervised like Xvfb rather than exec'd (issue #569):
# the main shell stays alive as the stack's supervisor. This launch must stay
# AFTER chrome's respawn subshell starts (step 3), so the display already has a
# client window when RFB comes up. agentd still reaps the whole group via
# killpg at StopBrowser, and x11vnc still handles its own signals meanwhile.
(
    trap - TERM INT EXIT
    # Same as the Xvfb supervisor: the subshell inherits `set -e`, so without
    # the `|| true` a crash exit aborts the subshell before the kill runs.
    "$here/bin/x11vnc" \
        -display "$DISPLAY" \
        -rfbport "$VNC_PORT" \
        -localhost \
        -forever -shared -noxdamage -nopw -quiet -xrandr || true
    echo "engram-browser: x11vnc died, tearing down the stack" >&2
    kill -TERM 0 2>/dev/null || true
) &

# 5) Park as the supervisor (issue #569): Xvfb and x11vnc are load-bearing —
# chrome has nowhere to render without the former, and the VNC tab has nothing
# to connect to without the latter — but before this both ran fire-and-forget,
# so either dying left the chrome respawn loop spinning forever against a dead
# display with nothing to notice or clean up. Each now runs under its own
# supervisor subshell (steps 1 and 4) that blocks on the daemon and signals the
# whole process group (`kill -TERM 0`) the instant it exits: event-driven and
# zero-latency, no per-second poll wakeups (the old loop forked a `sleep` every
# second forever), and immune to pid reuse (the old `kill -0 $PID` re-derived
# liveness from a pid the shell may have already reaped — reapable within ~1s,
# after which the pid is recyclable and the watchdog could green-light a
# stranger forever). The group TERM lands on this shell's trap → cleanup()
# disarms its traps first, then kills the group (chrome loop, the other
# supervisor, openbox — no recursion, and the supervisors die with the group).
# agentd's force-stop-on-failed-RFB-probe (#568) is what makes teardown the
# correct recovery — the next StartBrowser rebuilds a fresh stack rather than
# reattaching to a half-dead one.
wait
# Belt and suspenders: `wait` only returns here if every child vanished without
# any supervisor firing the group TERM; tear down explicitly regardless.
cleanup
exit 1
