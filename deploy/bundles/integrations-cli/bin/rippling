#!/bin/sh
# engrams Rippling CLI: a thin, generic wrapper over the Rippling REST API.
#
# Auth is brokered: this carries only the `RIPPLING_API_TOKEN` placeholder;
# the egress proxy injects the organization's real API token as
# `Authorization: Bearer` on every request to rest.ripplingapis.com and
# strips any token you supply. There is NOTHING to log in to; do not set a
# real token.
#
# Every resource of the API is reached through the same five verbs (list,
# get, create, update, delete) plus `api` for the routes that do not fit
# them. `rippling resources` prints the resource table. Each resource needs
# the matching power on your profile (rippling:workers:read,
# rippling:org:write, ...); a path your profile did not grant is denied at
# the network boundary, not authenticated.
#
# `list` follows every page (limit 100, cursor) and prints one JSON array
# when jq is present; without jq it prints the first page as the API returns
# it. The API version is the one the token was created with; set
# RIPPLING_API_VERSION (YYYY-MM-DD) to ask for another.
set -eu

BASE="https://rest.ripplingapis.com"
TOKEN="${RIPPLING_API_TOKEN:-x-engrams-managed}"
VERSION="${RIPPLING_API_VERSION:-}"

usage() {
    cat <<EOF
engrams Rippling CLI: auth is brokered by the platform (no token to set).

Usage:
  rippling resources                              Every resource, its verbs, and its extra routes
  rippling list <resource> [field=value ...]      Every page of a collection, as one array
  rippling get <resource> <id> [field=value ...]  One record
  rippling create <resource> <json>               Create a record
  rippling update <resource> <id> <json>          Change a record (PATCH)
  rippling delete <resource> <id>                 Delete a record
  rippling me                                     The caller's own user (sso-me)
  rippling api <METHOD> <path> [json-body]        Any route, with an explicit method and body

<resource> is a path segment such as workers, departments, or leave-requests;
it may carry a sub-path, such as custom-objects/<api-name>/records.

Query fields pass straight to the API. Rippling's own syntax:
  filter="status eq 'ACTIVE'"        operators: eq ne gt gte lt lte in and or
  filter="work_email eq 'a@b.com'"   strings in single quotes
  expand=user,manager                embed related records (depth 2, up to 10 fields)
  order_by=start_date                sort; prefix with - for descending

Examples:
  rippling list workers "filter=work_email eq 'a@example.com'" expand=user,manager
  rippling get workers <id> expand=manager,manager.user
  rippling list workers "filter=manager_id eq '<id>'" expand=user
  rippling list worker-changes "filter=updated_at gt '2026-10-01T00:00:00Z'"
  rippling list custom-objects/<api-name>/records
  rippling api POST custom-objects/<api-name>/records/query '{"query":"SELECT * FROM ..."}'
  rippling create report-runs '{"report_id":"<id>"}'

Responses are JSON. Fields the token cannot read are listed under
__meta.redacted_fields.
EOF
}

resources() {
    cat <<'EOF'
