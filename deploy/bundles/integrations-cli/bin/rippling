}

have_jq() { command -v jq >/dev/null 2>&1; }

pretty() {
    if have_jq; then jq .; else cat; fi
}

# Rippling paths start and end with a slash.
norm_path() {
    p="$1"
    case "$p" in
    /*) ;;
    *) p="/$p" ;;
    esac
    case "$p" in
    */ | *\?*) printf '%s' "$p" ;;
    *) printf '%s/' "$p" ;;
    esac
}

# request <METHOD> <path> [curl-args...]
request() {
    m="$1"
    p="$2"
    shift 2
    if [ -n "$VERSION" ]; then
        curl -sS -X "$m" "$BASE$(norm_path "$p")" \
            -H "Authorization: Bearer $TOKEN" \
            -H "Accept: application/json" \
            -H "Rippling-Api-Version: $VERSION" \
            "$@"
    else
        curl -sS -X "$m" "$BASE$(norm_path "$p")" \
            -H "Authorization: Bearer $TOKEN" \
            -H "Accept: application/json" \
            "$@"
    fi
}

# fetch <path> [field=value ...]: one GET; each field=value is a query param.
fetch() {
    p="$1"
    shift
    flags=$(for kv in "$@"; do printf '%s\n%s\n' '--data-urlencode' "$kv"; done)
    OLD_IFS=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $flags
    IFS=$OLD_IFS
    request GET "$p" -G "$@"
}

get() {
    fetch "$@" | pretty
}

# list <path> [field=value ...]: every page of a collection, one array.
list() {
    p="$1"
    shift
    if ! have_jq; then
        get "$p" "limit=100" "$@"
        return
    fi
    pages=$(mktemp)
    trap 'rm -f "$pages"' EXIT
    cursor=""
    while :; do
        if ! page=$(fetch "$p" "limit=100" ${cursor:+"cursor=$cursor"} "$@"); then
            echo "rippling: could not reach $BASE" >&2
            exit 1
        fi
        if ! printf '%s' "$page" | jq -e '.results' >/dev/null 2>&1; then
            # Not a collection envelope (an error, or a single object): show it as is.
            printf '%s\n' "$page" | pretty
            exit 1
        fi
        printf '%s\n' "$page" >>"$pages"
        next=$(printf '%s' "$page" | jq -r '.next_link // empty')
        [ -n "$next" ] || break
        # The next page is a URL carrying the cursor; take the cursor alone so
        # the request stays on the same path and headers.
        cursor=$(printf '%s' "$next" | sed -n 's/.*[?&]cursor=\([^&]*\).*/\1/p')
        [ -n "$cursor" ] || break
    done
    jq -s '[.[].results[]]' "$pages"
}

# send <METHOD> <path> <json-body>
send() {
    request "$1" "$2" -H "Content-Type: application/json" --data-binary "$3" | pretty
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
resources) resources ;;
list)
    r="${1:?usage: rippling list <resource> [field=value ...]}"
    shift
    list "$r" "$@"
    ;;
get)
    r="${1:?usage: rippling get <resource> <id> [field=value ...]}"
    id="${2:?usage: rippling get <resource> <id> [field=value ...]}"
    shift 2
    get "$r/$id" "$@"
    ;;
create)
    r="${1:?usage: rippling create <resource> <json>}"
    body="${2:?usage: rippling create <resource> <json>}"
    send POST "$r" "$body"
    ;;
update)
    r="${1:?usage: rippling update <resource> <id> <json>}"
    id="${2:?usage: rippling update <resource> <id> <json>}"
    body="${3:?usage: rippling update <resource> <id> <json>}"
    send PATCH "$r/$id" "$body"
    ;;
delete)
    r="${1:?usage: rippling delete <resource> <id>}"
    id="${2:?usage: rippling delete <resource> <id>}"
    request DELETE "$r/$id" | pretty
    ;;
me) get sso-me ;;
api)
    m="${1:?usage: rippling api <METHOD> <path> [json-body]}"
    p="${2:?usage: rippling api <METHOD> <path> [json-body]}"
    if [ -n "${3:-}" ]; then
        send "$m" "$p" "$3"
    else
        request "$m" "$p" | pretty
    fi
    ;;
"" | -h | --help | help) usage ;;
*)
    echo "rippling: unknown command '$cmd'" >&2
    usage
    exit 2
    ;;
esac
