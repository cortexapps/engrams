# Engram FC guest-kernel Docker fragment (ADR 0025).
#
# Merged on top of Firecracker's stock microvm-kernel-ci-x86_64-6.1 config
# (which is FC-bootable but strips the netfilter stack). These options make
# the guest able to run dockerd/containerd/compose *inside* the sandbox —
# the "engrams on engrams" dogfood loop (ADR 0023). Without them the stock
# kernel has no nf_tables and no `raw` table, so Docker 28+ can't start any
# bridge-networked container and bookworm's iptables-nft can't initialise.
#
# Verified on the dev-vm: with these, plain Docker 29 + compose run with the
# default nft backend and zero daemon workarounds (see ADR 0025).
#
# Applied via `scripts/kconfig/merge_config.sh -m <base> <this>` + `make
# olddefconfig`; build-fc-kernel.sh asserts the key symbols survived.

# --- nftables backend (bookworm's default iptables backend) ---
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y

# --- legacy xtables incl. the `raw` table Docker 28+ requires ---
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y

# --- netfilter core + xt matches Docker's per-container rules use ---
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# --- bridge netfilter + overlay networks ---
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VXLAN=y

# --- container storage + plumbing (belt-and-suspenders; stock already has these) ---
CONFIG_OVERLAY_FS=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
