# GKE Identity-Aware Proxy overlay — the SPLIT-HOST layout.
#
# Layer this on top of `values-gcp.yaml.example`:
#
#   helm install engram ./deploy/helm/engram \
#     -f values-gcp.yaml \
#     -f values-iap.yaml
#
# What this does
# --------------
# IAP guards the app host (the web nginx Service) so only authorized
# principals reach the dashboard. The machine surface — Connect RPC,
# /api/v1, SSE, WebSockets — is served from a SECOND hostname
# (`api.<domain>`) with no IAP in front, because an authenticating
# proxy breaks exactly that surface: IAP does not carry a WebSocket
# upgrade (the load balancer answers 502) and its backend timeout
# caps SSE lifetimes. The SPA calls the api host cross-origin
# (`web.apiBaseUrl` below); the orchestrator's CORS gate admits
# exactly `orchestrator.trustedOrigins`, and its own auth seams
# (session cookie / API key / webhook signatures) gate every route
# there. Anonymous callers get 401s from the app, not a proxy page.
#
# (Historical note: before the split-host layout this overlay carved
# a dozen per-path no-IAP exceptions out of the app host's URL map —
# one per webhook, CLI, and streaming route. That pattern broke every
# time a new streaming route shipped and is retired; only the two
# OIDC discovery paths below remain on the app host, because the
# OIDC issuer URI derives from `orchestrator.publicUrl`.)
#
# The coord itself stays unreachable from the internet — that
# invariant is set in the base GCP overlay (`service.type:
# ClusterIP`, `serviceInternal.annotations` = internal-only); this
# file does NOT attach IAP to the coord and never should.
#
# Pre-requisites the chart can't do for you
# -----------------------------------------
# 1. TWO DNS A records, both to the SAME load-balancer IP:
#    `engram.<domain>` and `api.engram.<domain>`.
#
# 2. TWO ManagedCertificates (Google-managed certs cannot hold
#    wildcards; provision one per host and list both in the Ingress
#    annotation below):
#
#      apiVersion: networking.gke.io/v1
#      kind: ManagedCertificate
#      metadata: { name: engram-web-cert }
#      spec: { domains: [engram.REPLACE_DOMAIN] }
#      ---
#      apiVersion: networking.gke.io/v1
#      kind: ManagedCertificate
#      metadata: { name: engram-api-cert }
#      spec: { domains: [api.engram.REPLACE_DOMAIN] }
#
# 3. OAuth consent screen configured in the GCP console (User Type
#    "Internal", support email set). One-time per project. No OAuth
#    *client* is needed — post-Jan-2026 IAP uses a Google-managed
#    client (https://cloud.google.com/iap/docs/deprecations/migrate-oauth-client).
#
# 4. A `BackendConfig` pair applied alongside the Helm release. IAP
#    is enabled per GCP *backend service*, so the app host's Service
#    carries an IAP-on config and the api host's webhook Service an
#    IAP-off one:
#
#      apiVersion: cloud.google.com/v1
#      kind: BackendConfig
#      metadata: { name: engram-web-iap }
#      spec:
#        iap: { enabled: true }
#        # 300s is fine here — no sockets or streams ride this host.
#      ---
#      apiVersion: cloud.google.com/v1
#      kind: BackendConfig
#      metadata: { name: engram-api-no-iap }
#      spec:
#        iap: { enabled: false }
#        # A backend timeout caps a SOCKET'S LIFETIME, not idleness:
#        # the default 30s (or the web host's 300s) would cut every
#        # quiet SSE/WebSocket leg. One hour matches the AWS ALB
#        # overlay's idle-timeout posture.
#        timeoutSec: 3600
#
# 5. `roles/iap.httpsResourceAccessor` bound to your authorized
#    principals (project-wide, or on the web backend service for
#    tighter scoping). Bind this ONLY to the web backend — the api
#    host's backend needs no accessor.
#
# What this overlay sets
# ----------------------

web:
  service:
    # The annotation that hooks the GKE Service → GCP Backend
    # Service → BackendConfig pipeline. The BackendConfig itself
    # lives outside the chart (pre-req #4).
    annotations:
      cloud.google.com/backend-config: '{"default":"engram-web-iap"}'

  # The SPA calls the api host directly for RPC, /api/v1, SSE and
  # WebSockets. Renders the /engram-config.js runtime override and
  # widens the SPA's CSP to the api origin (web-configmap.yaml).
  apiBaseUrl: https://api.engram.REPLACE_DOMAIN

  ingress:
    # One public HTTPS LB, two hosts. The BackendConfigs referenced
    # above give each backend its IAP posture; no IAP-specific field
    # exists on the Ingress itself.
    enabled: true
    className: gce
    annotations:
      kubernetes.io/ingress.class: gce
      # Pre-req #2; both certs on the one LB.
      networking.gke.io/managed-certificates: engram-web-cert,engram-api-cert
      # Optional but recommended: a static external IP reserved in
      # Terraform so both DNS records can be pre-created.
      # kubernetes.io/ingress.global-static-ip-name: engram-web-ip
    hosts:
      - host: engram.REPLACE_DOMAIN
        paths:
          # The ONLY carve-outs left on the app host: Google WIF
          # fetches these two public, read-only OIDC documents, and
          # the issuer URI inside them derives from
          # `orchestrator.publicUrl` — i.e. THIS host — so they
          # cannot move to the api host. No token or credential
          # endpoint is exposed here, and the orchestrator's IAP
          # bridge exempts exactly these paths.
          - path: /api/v1/integrations/google-cloud/oidc/.well-known/openid-configuration
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          - path: /api/v1/integrations/google-cloud/oidc/jwks
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          # Everything else on the app host → web nginx (IAP).
          - path: /
            pathType: Prefix
      # The api host: the whole machine surface on one rule. Provider
      # webhooks (signature-verified), the CLI's RPC + device-flow
      # login, dynamic automation hooks, the SSE feeds, and every
      # WebSocket (shell, VNC, spec sync) — each gated by the
      # orchestrator's own seams. Register Slack/GitHub webhook URLs
      # against this host (the dashboard's manifest generators emit
      # it automatically once `web.apiBaseUrl` is set).
      - host: api.engram.REPLACE_DOMAIN
        paths:
          - path: /
            pathType: Prefix
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'

orchestrator:
  # The SPA's origin, admitted by the orchestrator's credentialed
  # CORS gate and better-auth's CSRF check for the cross-origin
  # calls to the api host.
  trustedOrigins:
    - https://engram.REPLACE_DOMAIN
  # The session cookie must be scoped to the shared parent domain so
  # the browser attaches it on calls to the api host. Scope it to
  # YOUR deployment's subdomain (the leading dot matters), never to
  # a public suffix.
  sessionCookieDomain: .engram.REPLACE_DOMAIN
  # A dedicated Service for the api host + the two OIDC paths,
  # fronting the SAME orchestrator pods. The no-IAP BackendConfig
  # binds HERE — NOT on the primary orchestrator Service — so IAP
  # stays available on the primary Service for any other Ingress.
  webhookService:
    enabled: true
    annotations:
      cloud.google.com/backend-config: '{"default":"engram-api-no-iap"}'
