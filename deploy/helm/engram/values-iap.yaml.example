# GKE Identity-Aware Proxy overlay for the web Ingress.
#
# Layer this on top of `values-gcp.yaml.example`:
#
#   helm install engram ./deploy/helm/engram \
#     -f values-gcp.yaml \
#     -f values-iap.yaml
#
# What this does
# --------------
# IAP guards the single public surface (the web nginx Service) so
# only authorized principals can reach the dashboard and the API
# calls nginx proxies through to the coord. The coord itself stays
# unreachable from the internet — that invariant is set in the base
# GCP overlay (`service.type: ClusterIP`, `serviceInternal.annotations`
# = internal-only); this file does NOT attach IAP to the coord and
# never should.
#
# Pre-requisites the chart can't do for you
# -----------------------------------------
# 1. OAuth consent screen configured in the GCP console (User Type
#    "Internal", support email set). One-time per project. Required
#    so users see a branded login page; otherwise a generic Google
#    consent prompt appears. No OAuth *client* needed — see (2).
#
# 2. A `BackendConfig` CRD applied alongside the Helm release. The
#    post-Jan-2026 spec is minimal — the IAP OAuth Admin API was
#    retired so the old `oauthclientCredentials` flow no longer
#    functions. IAP now uses a Google-managed OAuth client per
#    request:
#
#      apiVersion: cloud.google.com/v1
#      kind: BackendConfig
#      metadata:
#        name: engram-web-iap
#      spec:
#        iap:
#          enabled: true
#
#    See https://cloud.google.com/iap/docs/deprecations/migrate-oauth-client.
#    The chart only needs to reference this BackendConfig by name
#    via the Service annotation below.
#
# 3. `roles/iap.httpsResourceAccessor` bound to your authorized
#    principals on the project (or on the backend service for tighter
#    scoping). On GCP: `google_iap_web_iam_member` resources, one
#    per principal. Bind this ONLY to the web backend — the no-IAP
#    Slack backend (below) needs no accessor.
#
# 4. A second, no-IAP `BackendConfig` for the orchestrator's public
#    provider and automation webhooks. IAP is enabled per GCP *backend service*, not per
#    path, so the only way to expose a path without IAP is to route it
#    to a different backend whose BackendConfig has IAP off. Apply it
#    from the chart's examples dir:
#
#      kubectl apply -n <ns> -f examples/backendconfig-slack-no-iap.yaml
#
#    This overlay then (a) enables a dedicated webhook Service
#    (`orchestrator.webhookService`) — fronting the SAME orchestrator
#    pods — and binds the no-IAP BackendConfig to IT (not to the primary
#    orchestrator Service, so IAP stays available there), and (b) adds
#    provider Exact paths plus the dynamic automation-hook Prefix to the web
#    Ingress, retargeted at that webhook Service. The orchestrator verifies
#    every webhook signature and its IAP bridge applies the narrower exact
#    application matcher before exempting dynamic hooks (ADRs 0060/0100/0102).
#
# What this overlay sets
# ----------------------

web:
  service:
    # The annotation that hooks the GKE Service → GCP Backend
    # Service → BackendConfig pipeline. The BackendConfig itself
    # lives outside the chart (see pre-req #2).
    annotations:
      cloud.google.com/backend-config: '{"default":"engram-web-iap"}'

  ingress:
    # Public HTTPS LB. The BackendConfig referenced above gives this
    # LB its IAP layer; no IAP-specific field on the Ingress.
    enabled: true
    className: gce
    annotations:
      kubernetes.io/ingress.class: gce
      # Provision separately; this annotation points at it by name.
      networking.gke.io/managed-certificates: engram-web-cert
      # Optional but recommended: a static external IP reserved in
      # Terraform so DNS records can be pre-created.
      # kubernetes.io/ingress.global-static-ip-name: engram-web-ip
    hosts:
      - host: engram.REPLACE_DOMAIN
        paths:
          # Provider webhooks: Slack external triggers (ADR 0060) + the GitHub
          # PR-review App (ADR 0100). Exact-match so ONLY these URLs are
          # retargeted at the dedicated no-IAP webhook Service; the
          # more-specific match wins in the URL map. They must precede the "/"
          # rule. The orchestrator verifies each provider's own signature
          # (Slack signing secret / GitHub X-Hub-Signature-256 HMAC) and its
          # IAP bridge exempts these paths, so dropping IAP here is safe.
          # `tpl`'d to the webhook Service fullname (resolved by
          # web-ingress.yaml).
          - path: /api/v1/integrations/slack/events
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          - path: /api/v1/integrations/slack/interactivity
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          - path: /api/v1/integrations/github/events
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          # Google WIF must fetch these two public, read-only OIDC documents.
          # No token or credential endpoint is exposed on this backend.
          - path: /api/v1/integrations/google-cloud/oidc/.well-known/openid-configuration
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          - path: /api/v1/integrations/google-cloud/oidc/jwks
            pathType: Exact
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          # Dynamic automation hooks need a Prefix rule at the load balancer;
          # the orchestrator's IAP bridge remains the exact POST + one-slug
          # application boundary within this no-IAP prefix (ADR 0102).
          - path: /api/v1/hooks/
            pathType: Prefix
            service: '{{ include "engram.orchestrator.fullname" . }}-webhooks'
          # Everything else → web nginx (IAP-protected).
          - path: /
            pathType: Prefix

orchestrator:
  # A dedicated Service for the public webhook paths, fronting the SAME
  # orchestrator pods. The no-IAP BackendConfig binds HERE — NOT on the primary
  # orchestrator Service — so IAP stays available on the primary Service for any
  # other Ingress (e.g. orchestrator.ingress). The web Ingress above routes the
  # Slack Exact paths at `<release>-orchestrator-webhooks`; GKE mints a separate
  # backend service for it, bound to the no-IAP BackendConfig below.
  webhookService:
    enabled: true
    annotations:
      cloud.google.com/backend-config: '{"default":"engram-slack-no-iap"}'
