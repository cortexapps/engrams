# GKE Identity-Aware Proxy overlay for the web Ingress.
#
# Layer this on top of `values-gcp.yaml.example`:
#
#   helm install engram ./deploy/helm/engram \
#     -f values-gcp.yaml \
#     -f values-iap.yaml
#
# What this does
# --------------
# IAP guards the single public surface (the web nginx Service) so
# only authorized principals can reach the dashboard and the API
# calls nginx proxies through to the coord. The coord itself stays
# unreachable from the internet — that invariant is set in the base
# GCP overlay (`service.type: ClusterIP`, `serviceInternal.annotations`
# = internal-only); this file does NOT attach IAP to the coord and
# never should.
#
# Pre-requisites the chart can't do for you
# -----------------------------------------
# 1. OAuth consent screen configured in the GCP console (User Type
#    "Internal", support email set). One-time per project. Required
#    so users see a branded login page; otherwise a generic Google
#    consent prompt appears. No OAuth *client* needed — see (2).
#
# 2. A `BackendConfig` CRD applied alongside the Helm release. The
#    post-Jan-2026 spec is minimal — the IAP OAuth Admin API was
#    retired so the old `oauthclientCredentials` flow no longer
#    functions. IAP now uses a Google-managed OAuth client per
#    request:
#
#      apiVersion: cloud.google.com/v1
#      kind: BackendConfig
#      metadata:
#        name: engram-web-iap
#      spec:
#        iap:
#          enabled: true
#
#    See https://cloud.google.com/iap/docs/deprecations/migrate-oauth-client.
#    The chart only needs to reference this BackendConfig by name
#    via the Service annotation below.
#
# 3. `roles/iap.httpsResourceAccessor` bound to your authorized
#    principals on the project (or on the backend service for tighter
#    scoping). On GCP: `google_iap_web_iam_member` resources, one
#    per principal.
#
# What this overlay sets
# ----------------------

web:
  service:
    # The annotation that hooks the GKE Service → GCP Backend
    # Service → BackendConfig pipeline. The BackendConfig itself
    # lives outside the chart (see pre-req #2).
    annotations:
      cloud.google.com/backend-config: '{"default":"engram-web-iap"}'

  ingress:
    # Public HTTPS LB. The BackendConfig referenced above gives this
    # LB its IAP layer; no IAP-specific field on the Ingress.
    enabled: true
    className: gce
    annotations:
      kubernetes.io/ingress.class: gce
      # Provision separately; this annotation points at it by name.
      networking.gke.io/managed-certificates: engram-web-cert
      # Optional but recommended: a static external IP reserved in
      # Terraform so DNS records can be pre-created.
      # kubernetes.io/ingress.global-static-ip-name: engram-web-ip
    hosts:
      - host: engram.REPLACE_DOMAIN
        paths:
          - path: /
            pathType: Prefix
