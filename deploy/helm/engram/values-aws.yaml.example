# AWS-flavored overlay. Apply with:
#   helm install engram ./deploy/helm/engram -f values-aws.yaml
#
# NB: ADR 0007 ships GCS as the first-class blob backend.
# `ENGRAM_BLOB_BACKEND=s3` is reserved but the engram-storage-s3
# crate is a stub — see docs/chunked-storage-rollout.md "Tier 4 #1".
# This overlay is a scaffold for when that lands; mirrors the GCP
# overlay's shape so the patterns line up.
#
# Assumptions:
# - EKS cluster with IRSA enabled.
# - An IAM role `engram-coordinator-role` has S3 read/write on the
#   chunks bucket, kms:Encrypt/Decrypt on the KEK key, and
#   secretsmanager:GetSecretValue on relevant secrets.

# ─── coordinator ──────────────────────────────────────────────────

image:
  repository: REPLACE_ACCOUNT.dkr.ecr.REPLACE_REGION.amazonaws.com/engram/coordinator
  tag: ""
  pullPolicy: IfNotPresent

mode: coordinator

blob:
  # NB: not yet implemented — see rollout doc Tier 4 #1.
  backend: gcs   # placeholder; flip to `s3` once stubs land.
  gcs:
    bucket: REPLACE_BUCKET

kek:
  # `aws-kms` provider isn't implemented yet either. Placeholder
  # for the future AWS path.
  provider: env-var
  envVarName: ENGRAM_KEK_MASTER_KEY

secrets:
  backend: env

database:
  existingSecret: engram-coordinator-secrets
  secretKey: DATABASE_URL

auth:
  existingSecret: engram-coordinator-secrets
  secretKey: ENGRAM_AUTH_TOKENS

serviceAccount:
  create: true
  name: engram-coordinator
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::REPLACE_ACCOUNT:role/engram-coordinator-role

service:
  type: ClusterIP
  port: 8080

serviceInternal:
  # Internal NLB targeting the coord, consumed by FC host-agents
  # dialing in from a sibling ASG inside the same VPC.
  loadBalancerIP: ""   # AWS NLBs don't honor loadBalancerIP; rely on Route53 + a stable DNS name instead.
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: nlb
    service.beta.kubernetes.io/aws-load-balancer-scheme: internal

# Coord never has a public ingress. Public reach goes through
# `web.ingress` below.
ingress:
  enabled: false

hpa:
  enabled: true
  minReplicas: 3
  maxReplicas: 20
  targetCPUUtilizationPercentage: 65

pdb:
  enabled: true
  minAvailable: 2

resources:
  requests:
    cpu: 1000m
    memory: 1Gi
  limits:
    cpu: 4000m
    memory: 4Gi

# ─── web ──────────────────────────────────────────────────────────

web:
  enabled: true

  image:
    repository: REPLACE_ACCOUNT.dkr.ecr.REPLACE_REGION.amazonaws.com/engram/web
    tag: ""
    pullPolicy: IfNotPresent

  ingress:
    # ALB fronting the web Service. Pair with Cognito-based auth for
    # the AWS equivalent of IAP (or AWS Verified Access).
    enabled: true
    className: alb
    annotations:
      kubernetes.io/ingress.class: alb
      alb.ingress.kubernetes.io/scheme: internet-facing
      alb.ingress.kubernetes.io/target-type: ip
    hosts:
      - host: engram.REPLACE_DOMAIN
        paths:
          - path: /
            pathType: Prefix
