# AWS (EKS) overlay — the ADR 0122 native-arm shape. Copy, replace
# the REPLACE_* placeholders, apply:
#
#   cp values-aws.yaml.example my-values.yaml
#   helm install engram ./deploy/helm/engram -n engrams -f my-values.yaml
#
# Assumptions:
# - EKS cluster with an OIDC provider (IRSA) and the AWS Load
#   Balancer Controller installed (the chart's `className: alb`
#   Ingress is inert without it). The Terraform quickstart's
#   eks-cluster module provisions both.
# - An IAM role for the coordinator KSA (IRSA trust on
#   engrams/engram-coordinator) granting: s3:{Get,Put,Delete,List}*
#   on the chunks bucket, kms:{Encrypt,Decrypt} on the KEK key, and
#   secretsmanager:GetSecretValue on the `engram/*` secret prefix.
# - The host fleet runs as the engram-host-fleet chart's DaemonSet on
#   a self-managed Intel nodegroup (see that chart's
#   values-aws.yaml.example) — so no internal LB is needed here.
# - Sign-in is OAuth against your identity provider (the
#   `orchestrator.auth` block at the bottom): only accounts on the
#   allowlist get in. No identity proxy sits in front of the app — the
#   orchestrator's login wall is the auth door (ADR 0118). ALB's
#   native OIDC/Cognito authentication is NOT supported in front of
#   this app — it breaks the same way IAP does (no cookie on CORS
#   preflights, no WebSocket carry; ADR 0118). Point
#   `orchestrator.auth.oauth` at the Cognito user pool instead.

# Image TAGS default to the chart appVersion, which is the release
# that this checkout is (`v<appVersion>`); leave them unset on a
# release tag. To run an unreleased build, set `image.tag`,
# `web.image.tag` and `orchestrator.image.tag` to the full SHA of a
# commit on main. Do not use the floating `main` tag: the pull policy
# is IfNotPresent, so a node that has `main` never pulls it again.
# The images are public; a mirror in a private registry needs
# `imagePullSecrets`.

# ─── coordinator ──────────────────────────────────────────────────

# Images come from the published GHCR defaults
# (ghcr.io/cortexapps/engrams/<coordinator|web|orchestrator>) — no
# override needed. To mirror into ECR instead:
# image:
#   repository: REPLACE_ACCOUNT.dkr.ecr.REPLACE_REGION.amazonaws.com/engram/coordinator

mode: coordinator

blob:
  backend: s3
  s3:
    bucket: REPLACE_BUCKET
    # Region for SigV4. Also settable via AWS_REGION on the pod (IRSA
    # injects it); explicit keeps the chart self-contained.
    region: REPLACE_REGION

kek:
  # The real AWS KMS provider (ADR 0122): wrap/unwrap of the data-
  # encryption keys via kms:Encrypt/Decrypt under this key. Key ARN
  # preferred (unambiguous); `alias/...` also works.
  provider: aws-kms
  awsKeyId: arn:aws:kms:REPLACE_REGION:REPLACE_ACCOUNT:key/REPLACE_KEY_ID

secrets:
  # AWS Secrets Manager via IRSA (ADR 0122). Image-manifest secret
  # refs resolve as `aws-sm://<name-or-arn>[#stage]`, or by default
  # namespacing `engram/<repo>/<NAME>`. No extra keys needed — region
  # and credentials ride the SDK chain.
  backend: aws

database:
  existingSecret: engram-coordinator-secrets
  secretKey: DATABASE_URL

auth:
  existingSecret: engram-coordinator-secrets
  secretKey: ENGRAM_AUTH_TOKENS

serviceAccount:
  create: true
  name: engram-coordinator
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::REPLACE_ACCOUNT:role/engram-coordinator

service:
  # In-cluster traffic: the web nginx proxy AND the host-fleet
  # DaemonSet both dial this ClusterIP (ADR 0044).
  type: ClusterIP
  port: 8080

# The in-cluster fleet dials the ClusterIP Service; an enabled
# internal LB here would mint a classic ELB nobody uses.
serviceInternal:
  enabled: false

ingress:
  enabled: false

# Static 2 replicas + PDB — the production-validated shape (ADR
# 0047/0048).
replicaCount: 2
hpa:
  enabled: false
pdb:
  enabled: true

resources:
  requests:
    cpu: 500m
    memory: 512Mi
  limits:
    cpu: 2000m
    memory: 2Gi

# ─── web ──────────────────────────────────────────────────────────

web:
  enabled: true
  replicaCount: 2

  service:
    type: ClusterIP
    port: 80
    annotations: {}

  ingress:
    # The single public surface: an internet-facing ALB (AWS Load
    # Balancer Controller) + ACM cert. One "/" rule is the whole
    # table — no identity proxy, so no per-backend path split.
    enabled: true
    className: alb
    annotations:
      alb.ingress.kubernetes.io/scheme: internet-facing
      # Pod IPs as targets (works with ClusterIP Services; no
      # NodePort needed).
      alb.ingress.kubernetes.io/target-type: ip
      # The ACM certificate for REPLACE_DOMAIN (the Terraform
      # quickstart provisions + validates it).
      alb.ingress.kubernetes.io/certificate-arn: arn:aws:acm:REPLACE_REGION:REPLACE_ACCOUNT:certificate/REPLACE_CERT_ID
      alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
      alb.ingress.kubernetes.io/ssl-redirect: "443"
      # An ALB idle timeout caps how long a quiet connection lives.
      # The product holds long SSE + WebSocket legs (the shell, the
      # IDE, /events); 3600 matches the nginx proxy_read_timeout and
      # the GCP deployment's socket-lifetime fix — the 60 s default
      # would cut every quiet session leg.
      alb.ingress.kubernetes.io/load-balancer-attributes: idle_timeout.timeout_seconds=3600
      alb.ingress.kubernetes.io/healthcheck-path: /healthz
    hosts:
      - host: engrams.REPLACE_DOMAIN
        paths:
          - path: /
            pathType: Prefix

# ─── orchestrator (ADR 0051) ──────────────────────────────────────

orchestrator:
  enabled: true
  publicUrl: https://engrams.REPLACE_DOMAIN
  databaseSecret:
    existingSecret: engram-orchestrator-secrets
    urlKey: ORCHESTRATOR_DATABASE_URL
    bearerKey: CONTROL_PLANE_BEARER
    authSecretKey: BETTER_AUTH_SECRET
  # The orchestrator seals its own tables in-process with a RAW 32-byte
  # key and has no KMS path, so with the coordinator on aws-kms the key
  # cannot come from the coordinator's Secret (the chart default). The
  # quickstart relays the `engram/kek-master` shell into the
  # orchestrator's Secret under this key.
  kekSecret:
    existingSecret: engram-orchestrator-secrets
    key: ENGRAM_KEK_MASTER_KEY
  # How people sign in. `oauth` is the door for a deployment on the
  # internet; the chart's values.yaml documents the other two
  # (`iap`, `password`) in the same block.
  auth:
    mode: oauth
    oauth:
      # Your OIDC provider's issuer URL, for example:
      #   Google:   https://accounts.google.com
      #   Cognito:  https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
      #   Okta:     https://<org>.okta.com
      issuer: REPLACE_OAUTH_ISSUER
      # Register a web client with the provider, with the redirect URI
      #   https://engrams.REPLACE_DOMAIN/api/auth/oauth2/callback/sso
      clientId: REPLACE_OAUTH_CLIENT_ID
      # The Terraform quickstart relays the `engram/oauth-client-secret`
      # Secrets Manager entry into this Secret.
      clientSecret:
        existingSecret: engram-oauth-client
        secretKey: ORCHESTRATOR_OAUTH_CLIENT_SECRET
      # Who may sign in: every account of this email domain. `"*"`
      # admits every account the provider authenticates — correct for
      # a provider that holds only your own people (a Cognito user
      # pool, an Okta org), wide open for a public one (Google).
      allowedDomains:
        - REPLACE_EMAIL_DOMAIN
    # Bootstrap admins: promoted to role 'admin' on first sign-in.
    adminEmails:
      - REPLACE_ADMIN_EMAIL
