# GCP (GKE) overlay — the in-cluster ADR 0044 topology the production
# deployment runs. Copy, replace the REPLACE_* placeholders, apply:
#
#   cp values-gcp.yaml.example my-values.yaml
#   helm install engram ./deploy/helm/engram -n engrams -f my-values.yaml
#
# Assumptions:
# - GKE Standard cluster with Workload Identity enabled (the charts'
#   PodMonitoring also wants `managed_prometheus` on the cluster).
# - A Google Service Account `engram-coordinator@<project>.iam.gserviceaccount.com`
#   granted: roles/storage.objectAdmin on the chunks bucket and
#   roles/secretmanager.secretAccessor on the deployment secrets.
# - The KSA → GSA Workload Identity binding is in place:
#     gcloud iam service-accounts add-iam-policy-binding \
#       --role roles/iam.workloadIdentityUser \
#       --member "serviceAccount:<project>.svc.id.goog[engrams/engram-coordinator]" \
#       engram-coordinator@REPLACE_PROJECT.iam.gserviceaccount.com
# - The host fleet runs as the engram-host-fleet chart's DaemonSet in
#   the same cluster (see that chart's values-gcp.yaml.example).
# - No identity proxy by default: the orchestrator's login wall
#   (better-auth + `orchestrator.auth.adminEmails`) is the auth door
#   (ADR 0118). IAP is an opt-in layer — values-iap.yaml.example.

# ─── coordinator ──────────────────────────────────────────────────

# Image REPOSITORIES come from the published GHCR defaults
# (ghcr.io/cortexapps/engrams/<coordinator|web|orchestrator>) — no
# override needed. To mirror into Artifact Registry instead:
# image:
#   repository: us-docker.pkg.dev/REPLACE_PROJECT/engram/coordinator
#
# Image TAGS must be set (here and in the web/orchestrator blocks
# below): the chart's empty-tag fallback is the chart appVersion,
# which the bake pipeline does not publish. `main` tracks the latest
# build; pin a SHA tag for reproducible rollouts.
image:
  tag: main

# While the repository is private, GHCR needs a pull secret in the
# release namespace (a GitHub PAT with read:packages):
#
#   kubectl create secret docker-registry ghcr-pull -n engrams \
#     --docker-server=ghcr.io --docker-username=<gh-user> --docker-password=<PAT>
#
# Delete this once the packages are public.
imagePullSecrets:
  - name: ghcr-pull

mode: coordinator

blob:
  backend: gcs
  gcs:
    bucket: REPLACE_BUCKET

kek:
  # env-var is what production runs today: GcpKmsProvider wrap/unwrap
  # are stubs in the coordinator. Keep the 32-byte base64 master key in
  # Secret Manager and mirror it into the coordinator Secret's
  # ENGRAM_KEK_MASTER_KEY field (External Secrets Operator is the
  # standard relay); the chart's deployment.yaml injects it when
  # provider=env-var.
  provider: env-var

secrets:
  backend: gcp
  gcpProjectId: REPLACE_PROJECT

database:
  existingSecret: engram-coordinator-secrets
  secretKey: DATABASE_URL

auth:
  # The machine bearer (host-agent → coordinator, and the app-gRPC
  # default). Human auth lives in the orchestrator (ADR 0051).
  existingSecret: engram-coordinator-secrets
  secretKey: ENGRAM_AUTH_TOKENS

serviceAccount:
  create: true
  name: engram-coordinator
  annotations:
    iam.gke.io/gcp-service-account: engram-coordinator@REPLACE_PROJECT.iam.gserviceaccount.com

service:
  # In-cluster traffic: the web nginx proxy AND the host-fleet
  # DaemonSet both dial this ClusterIP (ADR 0044 — the fleet is
  # in-cluster, so no internal LB is involved).
  type: ClusterIP
  port: 8080

# The internal LB exists for OUT-of-cluster fleets only. The ADR 0044
# in-cluster DaemonSet dials the ClusterIP Service above, so the LB
# would be an unused GCP forwarding rule. Re-enable (plus the
# annotations below) only for a fleet outside the cluster:
serviceInternal:
  enabled: false
  # loadBalancerIP: REPLACE_RESERVED_INTERNAL_IP
  # annotations:
  #   networking.gke.io/load-balancer-type: "Internal"
  #   networking.gke.io/internal-load-balancer-allow-global-access: "true"

# Coord ingress stays disabled — only the web component has a public
# surface.
ingress:
  enabled: false

# Static 2 replicas + PDB is the production-validated shape (ADR 0047
# stateless coordinator; ADR 0048 I2 two-replica validation). Turn the
# HPA on only after that baseline holds for your load.
replicaCount: 2
hpa:
  enabled: false
pdb:
  enabled: true

resources:
  requests:
    cpu: 500m
    memory: 512Mi
  limits:
    cpu: 2000m
    memory: 2Gi

# Google Managed Prometheus scrapes /metrics via the chart's
# PodMonitoring CRD. Needs `managed_prometheus` enabled on the cluster
# — without it the CRD is inert.
metrics:
  podMonitoring:
    enabled: true
    interval: "30s"

# ─── web ──────────────────────────────────────────────────────────

web:
  enabled: true
  replicaCount: 2
  image:
    tag: main   # see the tag note above

  service:
    type: ClusterIP
    port: 80
    # The GCLB's DEFAULT backend timeout is 30s and it caps a
    # connection's LIFETIME — every WebSocket (shell, VNC, spec sync)
    # and SSE leg dies at that mark with no close frame. The quickstart
    # applies the BackendConfig this references (engram-web,
    # timeoutSec 3600); a manual install must apply it too:
    #
    #   apiVersion: cloud.google.com/v1
    #   kind: BackendConfig
    #   metadata: { name: engram-web }
    #   spec: { timeoutSec: 3600 }
    #
    # Allow ~10 minutes after applying for the load balancer to
    # program before judging WebSockets. (values-iap.yaml.example
    # replaces this with its own IAP-enabled pair.)
    annotations:
      cloud.google.com/backend-config: '{"default":"engram-web"}'
    annotations: {}

  ingress:
    # The single public surface: Google HTTPS LB + managed cert. With
    # no identity proxy, one "/" rule is the whole table — the
    # orchestrator's login wall is the auth door (ADR 0118). The
    # values-iap.yaml.example overlay replaces this with the
    # per-backend path table IAP requires.
    enabled: true
    className: gce
    annotations:
      kubernetes.io/ingress.class: gce
      # Create the ManagedCertificate CRD separately (or via the
      # Terraform quickstart) and reference it by name here.
      networking.gke.io/managed-certificates: engram-web-cert
      # Recommended: a static external IP reserved in Terraform so the
      # DNS record can be created before the LB exists.
      # kubernetes.io/ingress.global-static-ip-name: engram-web-ip
    hosts:
      - host: engrams.REPLACE_DOMAIN
        paths:
          - path: /
            pathType: Prefix

# ─── orchestrator (ADR 0051) ──────────────────────────────────────

orchestrator:
  enabled: true
  image:
    tag: main   # see the tag note above
  # The public URL — same host as the web Ingress above.
  publicUrl: https://engrams.REPLACE_DOMAIN
  databaseSecret:
    existingSecret: engram-orchestrator-secrets
    urlKey: ORCHESTRATOR_DATABASE_URL
    bearerKey: CONTROL_PLANE_BEARER
    authSecretKey: BETTER_AUTH_SECRET
  auth:
    # Bootstrap admins: each email is promoted to role 'admin' on
    # first sign-in — how a fresh deploy gets a root account without a
    # manual DB UPDATE.
    adminEmails:
      - REPLACE_ADMIN_EMAIL
