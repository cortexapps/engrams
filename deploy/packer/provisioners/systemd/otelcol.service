# Engram per-host OpenTelemetry Collector (ADR 0019).
#
# Local trace collector: receives OTLP on :4317 from host-agent (localhost)
# and in-guest agentd (via the per-sandbox TAP gateway), forwards traces to
# Google Cloud Trace (googlecloud exporter, ADC via the instance SA). Config
# at /etc/otelcol/config.yaml (baked from deploy/otel/collector-gcp.yaml).
#
# Ordered before engram-host-agent so the receiver is listening when the
# first spans are emitted; failure is non-fatal to the host (tracing is
# best-effort — Restart keeps it trying without blocking sandbox work).

[Unit]
Description=Engram OpenTelemetry Collector (traces -> Cloud Trace)
After=network-online.target
Wants=network-online.target
Before=engram-host-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/otelcol-contrib --config /etc/otelcol/config.yaml
Restart=on-failure
RestartSec=5s

# Unprivileged: the collector only needs the network + ADC metadata. Lock
# everything else down.
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Bounded memory mirrors the collector's own memory_limiter; a hard cap so
# tracing can never starve Firecracker on the host.
MemoryMax=192M

[Install]
WantedBy=multi-user.target
