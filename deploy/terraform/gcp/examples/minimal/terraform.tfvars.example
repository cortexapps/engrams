project_id  = "your-gcp-project"
region      = "us-central1"
name_prefix = "engram-dev"

# Bearer token the FC host-agents send on WS upgrade. Must match one
# of the comma-separated entries in the coord's ENGRAM_AUTH_TOKENS
# Secret. Generate with `openssl rand -hex 32`.
coordinator_token = ""

host_count        = 3
host_machine_type = "n2-standard-8"
