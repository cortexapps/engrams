#!/bin/sh
# ADR 0023 GIT_ASKPASS helper (dogfood image).
#
# git invokes this with the prompt string as $1. For the username half it
# returns the fixed `x-access-token` (also set via `credential.<host>.username`,
# so this branch is belt-and-suspenders); for the password it asks the
# engrams host for a fresh, short-lived credential over the forge vsock
# bridge. The real token never persists in the guest.
case "$1" in
    *[Uu]sername*) printf 'x-access-token' ;;
    *) exec engram-agentd forge-credential --host github.com ;;
esac
