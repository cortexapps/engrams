{
  "provider": "slack",
  "protocol": "http",
  "display": {
    "name": "Slack",
    "category": "Communication",
    "blurb": "Post and manage messages, browse channels and history, react, pin, upload files, and read users \u2014 authenticated with a workspace bot token obtained via OAuth (\"Add to Slack\").",
    "icon": {
      "mono": "SL",
      "color": "#611f69"
    }
  },
  "credential": {
    "source": "inject",
    "injects": [
      {
        "header": "Authorization",
        "template": "Bearer {}"
      }
    ]
  },
  "userCredential": {
    "oauth": {
      "scopes": [
        "chat:write",
        "channels:read",
        "channels:history",
        "channels:write",
        "groups:read",
        "groups:history",
        "im:read",
        "im:history",
        "mpim:read",
        "users:read",
        "users:read.email",
        "files:read",
        "files:write",
        "reactions:read",
        "reactions:write",
        "pins:read",
        "pins:write",
        "bookmarks:read",
        "bookmarks:write",
        "usergroups:read",
        "team:read",
        "emoji:read"
      ],
      "scopesParam": "user_scope",
      "grantPath": "authed_user",
      "metadata": {
        "fromTokenResponse": {
          "accountId": "authed_user.id",
          "workspaceId": "team.id",
          "workspaceName": "team.name"
        }
      }
    }
  },
  "webhook": {
    "verificationScheme": "slack_v0",
    "events": [
      {
        "key": "app_mention",
        "label": "App mention",
        "description": "The app was @-mentioned in a channel.",
        "schema": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "ts": {
                  "type": "string"
                },
                "thread_ts": {
                  "type": "string"
                }
              }
            }
          }
        },
        "handleCandidates": [
          {
            "parts": [
              {
                "lit": "slack:"
              },
              {
                "path": "event.channel"
              },
              {
                "lit": ":"
              },
              {
                "path": "event.thread_ts"
              }
            ]
          }
        ]
      },
      {
        "key": "message",
        "label": "Message posted (incl. thread replies)",
        "description": "A message was posted in a channel or thread the app can see.",
        "schema": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "ts": {
                  "type": "string"
                },
                "thread_ts": {
                  "type": "string"
                },
                "channel_type": {
                  "type": "string"
                }
              }
            }
          }
        },
        "handleCandidates": [
          {
            "parts": [
              {
                "lit": "slack:"
              },
              {
                "path": "event.channel"
              },
              {
                "lit": ":"
              },
              {
                "path": "event.thread_ts"
              }
            ]
          }
        ]
      },
      {
        "key": "reaction_added",
        "label": "Reaction added",
        "description": "An emoji reaction was added to a message.",
        "schema": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "reaction": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                },
                "item": {
                  "type": "object",
                  "properties": {
                    "channel": {
                      "type": "string"
                    },
                    "ts": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "handleCandidates": [
          {
            "parts": [
              {
                "lit": "slack:"
              },
              {
                "path": "event.item.channel"
              },
              {
                "lit": ":"
              },
              {
                "path": "event.item.ts"
              }
            ]
          }
        ]
      }
    ],
    "aliases": [
      {
        "path": "event.text",
        "alias": "message.text"
      },
      {
        "path": "event.user",
        "alias": "actor.id"
      },
      {
        "path": "event.channel",
        "alias": "channel.id"
      },
      {
        "path": "event.ts",
        "alias": "message.timestamp"
      },
      {
        "path": "event.reaction",
        "alias": "reaction.name"
      },
      {
        "path": "event.item.channel",
        "alias": "reaction.channel.id"
      },
      {
        "path": "event.item.ts",
        "alias": "reaction.message_timestamp"
      }
    ],
    "ingress": {
      "scheme": "slack_v0",
      "secretRef": "slack.signing_secret"
    },
    "scope": {
      "key": "channels",
      "label": "Channels",
      "path": "event.channel"
    }
  },
  "hosts": [
    "slack.com"
  ],
  "test": {
    "path": "/api/auth.test"
  },
  "operations": [
    {
      "grants": [
        "chat:write"
      ],
      "match": {
        "path": "/api/chat.*"
      }
    },
    {
      "grants": [
        "channels:read"
      ],
      "match": {
        "path": "/api/conversations.list"
      }
    },
    {
      "grants": [
        "channels:read"
      ],
      "match": {
        "path": "/api/conversations.info"
      }
    },
    {
      "grants": [
        "channels:read"
      ],
      "match": {
        "path": "/api/conversations.history"
      }
    },
    {
      "grants": [
        "channels:read"
      ],
      "match": {
        "path": "/api/conversations.replies"
      }
    },
    {
      "grants": [
        "channels:read"
      ],
      "match": {
        "path": "/api/conversations.members"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.create"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.invite"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.archive"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.rename"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.setTopic"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.setPurpose"
      }
    },
    {
      "grants": [
        "channels:manage"
      ],
      "match": {
        "path": "/api/conversations.join"
      }
    },
    {
      "grants": [
        "users:read"
      ],
      "match": {
        "path": "/api/users.*"
      }
    },
    {
      "grants": [
        "files:read"
      ],
      "match": {
        "path": "/api/files.list"
      }
    },
    {
      "grants": [
        "files:read"
      ],
      "match": {
        "path": "/api/files.info"
      }
    },
    {
      "grants": [
        "files:write"
      ],
      "match": {
        "path": "/api/files.upload"
      }
    },
    {
      "grants": [
        "files:write"
      ],
      "match": {
        "path": "/api/files.getUploadURLExternal"
      }
    },
    {
      "grants": [
        "files:write"
      ],
      "match": {
        "path": "/api/files.completeUploadExternal"
      }
    },
    {
      "grants": [
        "files:write"
      ],
      "match": {
        "path": "/api/files.delete"
      }
    },
    {
      "grants": [
        "reactions:read"
      ],
      "match": {
        "path": "/api/reactions.list"
      }
    },
    {
      "grants": [
        "reactions:read"
      ],
      "match": {
        "path": "/api/reactions.get"
      }
    },
    {
      "grants": [
        "reactions:write"
      ],
      "match": {
        "path": "/api/reactions.add"
      }
    },
    {
      "grants": [
        "reactions:write"
      ],
      "match": {
        "path": "/api/reactions.remove"
      }
    },
    {
      "grants": [
        "pins:read"
      ],
      "match": {
        "path": "/api/pins.list"
      }
    },
    {
      "grants": [
        "pins:write"
      ],
      "match": {
        "path": "/api/pins.add"
      }
    },
    {
      "grants": [
        "pins:write"
      ],
      "match": {
        "path": "/api/pins.remove"
      }
    },
    {
      "grants": [
        "bookmarks:read"
      ],
      "match": {
        "path": "/api/bookmarks.list"
      }
    },
    {
      "grants": [
        "bookmarks:write"
      ],
      "match": {
        "path": "/api/bookmarks.add"
      }
    },
    {
      "grants": [
        "bookmarks:write"
      ],
      "match": {
        "path": "/api/bookmarks.edit"
      }
    },
    {
      "grants": [
        "bookmarks:write"
      ],
      "match": {
        "path": "/api/bookmarks.remove"
      }
    },
    {
      "grants": [
        "usergroups:read"
      ],
      "match": {
        "path": "/api/usergroups.*"
      }
    },
    {
      "grants": [
        "views:write"
      ],
      "match": {
        "path": "/api/views.*"
      }
    },
    {
      "grants": [
        "team:read"
      ],
      "match": {
        "path": "/api/team.info"
      }
    },
    {
      "grants": [
        "team:read"
      ],
      "match": {
        "path": "/api/emoji.list"
      }
    },
    {
      "grants": [
        "chat:write",
        "channels:read",
        "channels:manage",
        "users:read",
        "files:read",
        "files:write",
        "reactions:read",
        "reactions:write",
        "pins:read",
        "pins:write",
        "bookmarks:read",
        "bookmarks:write",
        "usergroups:read",
        "views:write",
        "team:read"
      ],
      "match": {
        "path": "/api/auth.test"
      }
    }
  ],
  "cli": {
    "bins": [
      "slack"
    ],
    "binSource": "bundled",
    "dummyEnv": {
      "SLACK_TOKEN": "x-engrams-managed"
    },
    "credentialDelivery": "inject",
    "doc": "Use `slack` to interact with Slack from this session \u2014 post and manage messages, browse channels and history, react, pin, upload files, and read users. Authentication is automatic: the egress proxy injects the workspace bot token on requests to slack.com; `SLACK_TOKEN` is a managed placeholder. Do NOT set a real token or run any login. Slack always replies HTTP 200 with JSON `{\"ok\":true,\u2026}` or `{\"ok\":false,\"error\":\u2026}`.\n\n<channel> is a channel ID (e.g. C0123456789) or #name; the bot must be in the channel (or the app needs chat:write.public).\n\nMessaging (needs `chat:write`):\n  slack post <channel> <text...>        Post a message (chat.postMessage)\n  slack reply <channel> <thread-ts> <text...>  Reply in a thread (chat.postMessage with thread_ts)\n  slack dm <user-id> <text...>          DM a user by ID\nReading channels (needs `channels:read`):\n  slack channels [field=value ...]      List conversations (conversations.list)\n  slack history <channel> [field=value] List recent messages (conversations.history)\n  slack replies <channel> <ts>          List a thread (conversations.replies)\nManaging channels (needs `channels:manage`): create/invite/archive/rename/join \u2014 via `slack api conversations.<method> \u2026`.\nUsers (needs `users:read`):\n  slack users [field=value ...]         List members (users.list)\nFiles: `slack upload <channel> <file> [title]` needs `files:write`; `slack api files.list` needs `files:read`.\nReactions (needs `reactions:write`):\n  slack react <channel> <ts> <emoji>    Add a reaction (reactions.add)\nPins (needs `pins:write`):\n  slack pin <channel> <ts>              Pin a message (pins.add)\nIdentity: `slack whoami` (auth.test). Other Web API methods: `slack api <method> field=value \u2026` (e.g. `slack api conversations.create name=proj-x`). Bookmarks (`bookmarks:*`), usergroups (`usergroups:read`), modals/App Home (`views:write`), and team/emoji (`team:read`) are reachable via `slack api`. A method whose power your profile didn't grant is denied at the network boundary, not authenticated."
  },
  "oauth": {
    "authorizeUrl": "https://slack.com/oauth/v2/authorize",
    "tokenUrl": "https://slack.com/api/oauth.v2.access",
    "scopes": [
      "chat:write",
      "app_mentions:read",
      "channels:read",
      "channels:history",
      "channels:manage",
      "groups:read",
      "groups:history",
      "im:read",
      "im:history",
      "mpim:read",
      "users:read",
      "users:read.email",
      "files:read",
      "files:write",
      "reactions:read",
      "reactions:write",
      "pins:read",
      "pins:write",
      "bookmarks:read",
      "bookmarks:write",
      "usergroups:read",
      "team:read",
      "emoji:read"
    ],
    "clientIdRef": "slack.client_id",
    "clientSecretRef": "slack.client_secret",
    "signingSecretRef": "slack.signing_secret",
    "metadata": {
      "fromTokenResponse": {
        "accountId": "team.id",
        "workspaceId": "team.id",
        "workspaceName": "team.name"
      }
    }
  },
  "actions": [
    {
      "id": "post_message",
      "label": "Post a message",
      "description": "Post a message to a channel or thread.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "threadTs": {
            "type": "string"
          }
        },
        "required": [
          "channel",
          "text"
        ]
      },
      "execute": {
        "kind": "builtin",
        "id": "slack.post_message"
      },
      "output": {
        "ts": "ts",
        "channel": "channel"
      },
      "idempotency": {
        "kind": "none"
      },
      "handles": [
        {
          "parts": [
            {
              "lit": "slack:"
            },
            {
              "path": "output.channel"
            },
            {
              "lit": ":"
            },
            {
              "path": "input.threadTs"
            }
          ]
        },
        {
          "parts": [
            {
              "lit": "slack:"
            },
            {
              "path": "output.channel"
            },
            {
              "lit": ":"
            },
            {
              "path": "output.ts"
            }
          ]
        }
      ]
    },
    {
      "id": "join_channel",
      "label": "Join a channel",
      "description": "Join a public channel as the app, so channel messages reach the automation (message events only flow where the bot is a member). Idempotent when already joined; private channels need a human /invite instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          }
        },
        "required": [
          "channel"
        ]
      },
      "execute": {
        "kind": "builtin",
        "id": "slack.join_channel"
      },
      "output": {
        "channel": "channel"
      },
      "idempotency": {
        "kind": "none"
      }
    },
    {
      "id": "update_message",
      "label": "Update a message",
      "description": "Edit a message the app posted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "channel",
          "ts",
          "text"
        ]
      },
      "execute": {
        "kind": "builtin",
        "id": "slack.update_message"
      },
      "idempotency": {
        "kind": "natural"
      }
    }
  ]
}
