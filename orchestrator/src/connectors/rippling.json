    "name": "Rippling",
    "category": "HR & people",
    "blurb": "Read your Rippling HR system from a session: workers and their managers, departments, teams, locations, leave, time, devices, and the activity log, plus custom objects and reports. Authenticated with an API token brokered at the egress proxy, never seen by the agent.",
    "icon": {
      "mono": "RP",
      "color": "#fcb315"
    }
  },
  "credential": {
    "source": "inject",
    "injects": [
      {
        "header": "Authorization",
        "template": "Bearer {}",
        "secretRef": "rippling.api_token"
      }
    ]
  },
