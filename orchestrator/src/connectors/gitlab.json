    "aliases": [
      {
        "path": "object_attributes.title",
        "alias": "merge_request.title"
      },
      {
        "path": "object_attributes.iid",
        "alias": "merge_request.iid"
      },
      {
        "path": "project.path_with_namespace",
        "alias": "project.path"
      },
      {
        "path": "user.username",
        "alias": "actor.login"
      }
    ],
    "ingress": {
      "scheme": "gitlab_webhook",
      "secretRef": "gitlab.webhook_secret"
    },
    "scope": {
      "key": "projects",
      "label": "Projects",
      "path": "project.path_with_namespace"
    }
  },
  "actions": [
    {
      "id": "post_pr_review",
      "label": "Post a merge request review",
      "description": "Post a review on a merge request: a summary comment and a thread on each commented line.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "prNumber": {
            "type": "integer"
          },
          "commitId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "fallbackSummary": {
            "type": "string"
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "start_line": {
                  "type": "integer"
                },
                "side": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "finding_id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "repo",
          "prNumber",
          "summary"
        ]
      },
      "execute": {
        "kind": "builtin",
        "id": "gitlab.post_pr_review"
      },
      "idempotency": {
        "kind": "marker_comment"
      },
      "handles": [
        {
          "parts": [
            {
              "lit": "gitlab:"
            },
            {
              "path": "input.repo"
            },
            {
              "lit": "#"
            },
            {
              "path": "input.prNumber"
            }
          ]
        }
      ]
    },
    {
      "id": "upsert_pr_comment",
      "label": "Create or reuse a pinned comment",
      "description": "Post a comment on a merge request once per key. A later call with the same key returns the id of the comment an earlier call posted; edit it with update_pr_comment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "key": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "number",
          "key",
          "body"
        ]
      },
      "execute": {
        "kind": "builtin",
        "id": "gitlab.upsert_pr_comment"
      },
      "output": {
        "commentId": "commentId"
      },
      "idempotency": {
        "kind": "marker_comment",
        "markerTemplate": "<!-- engrams-pinned:{input.key} -->"
      },
      "handles": [
        {
          "parts": [
            {
              "lit": "gitlab:"
            },
            {
              "path": "input.repo"
            },
            {
              "lit": "#"
            },
            {
              "path": "input.number"
            }
          ]
        }
      ]
    },
    {
      "id": "update_pr_comment",
      "label": "Rewrite a pinned comment",
      "description": "Edit a comment that upsert_pr_comment posted. The key's marker goes back on the new body, so a later upsert_pr_comment with the same key still finds the comment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "commentId": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "commentId",
          "key",
          "body"
        ]
      },
      "execute": {
        "kind": "builtin",
        "id": "gitlab.update_pr_comment"
      },
      "idempotency": {
        "kind": "marker_comment",
        "markerTemplate": "<!-- engrams-pinned:{input.key} -->"
      }
    }
  ],
  "cli": {
    "bins": ["glab"],
    "binSource": "bundled",
    "dummyEnv": { "GITLAB_TOKEN": "x-engrams-managed" },
    "credentialDelivery": "inject",
    "doc": "Use `glab` (the official GitLab CLI) to drive GitLab from this session — browse projects, open and review merge requests and issues, and inspect CI/CD pipelines. Authentication is automatic: the egress proxy adds the GitLab access token to every request your powers allow, on the REST API (/api/v4) and on git over HTTPS, and strips anything you supply. `GITLAB_TOKEN` is a managed placeholder. Do NOT run `glab auth login` or set a real token.\n\nCommon commands and the power each needs:\n- Projects: `glab repo view <group/project>`, `glab repo list` — requires `projects:read`.\n- Merge requests: `glab mr list`, `glab mr view <id>` (requires `merge_requests:read`); `glab mr create --source-branch <b> --target-branch main --title \"...\" --description \"...\"` (requires `merge_requests:write`). To open an MR: push your branch first, then create the MR.\n- Issues: `glab issue list`, `glab issue view <iid>` (requires `issues:read`); `glab issue create --title \"...\" --description \"...\"` (requires `issues:write`).\n- Pipelines: `glab ci list`, `glab ci status`, `glab ci view` (requires `pipelines:read`); `glab ci run`/`glab ci trigger` (requires `pipelines:write`).\n- Repository contents (files, tree, commits, branches, tags): read requires `repository:read`; creating commits via the API requires `repository:write`.\n- Git: `git clone https://<host>/<group>/<project>.git` and `git fetch` require `repository:read`; `git push` requires `repository:write`. Use HTTPS remotes that end in `.git`, with no credential in the URL and no credential helper. Git LFS is not available.\n\nRaw REST passthrough: `glab api projects/:id/merge_requests` (GET) or `glab api --method POST projects/:id/issues -f title=\"...\"`. Only the resource families your profile granted are reachable — a call to a path you weren't granted is denied at the network boundary, not authenticated. Run `glab --help` to explore."
  }
}
