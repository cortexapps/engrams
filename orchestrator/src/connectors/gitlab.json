{
  "provider": "gitlab",
  "protocol": "http",
  "display": {
    "name": "GitLab",
    "category": "Source control",
    "blurb": "Browse projects, open merge requests and issues, and inspect pipelines — driven by the official `glab` CLI and authenticated with a brokered personal access token.",
    "icon": { "mono": "GL", "color": "#fc6d26" }
  },
  "credential": {
    "source": "inject",
    "injects": [
      { "header": "Authorization", "template": "Bearer {}", "secretRef": "gitlab.api_token" }
    ]
  },
  "settings": [
    {
      "name": "api_host",
      "label": "GitLab host",
      "kind": "host",
      "options": [{ "value": "gitlab.com", "label": "GitLab.com" }],
      "custom": {
        "label": "Self-managed",
        "hint": "The hostname of your GitLab instance, for example gitlab.example.com. No scheme, port, or path."
      },
      "default": "gitlab.com",
      "env": "GITLAB_HOST",
      "hint": "The GitLab your token belongs to. Sessions reach this host and no other GitLab host."
    }
  ],
  "hosts": [],
  "test": { "path": "/api/v4/user" },
  "operations": [
    {
      "grants": ["projects:read"],
      "match": { "method": "GET", "path": "/api/v4/projects*" }
    },
    {
      "grants": ["merge_requests:read"],
      "match": { "method": "GET", "path": "/api/v4/projects/*/merge_requests*" }
    },
    {
      "grants": ["merge_requests:write"],
      "match": { "method": "POST", "path": "/api/v4/projects/*/merge_requests" },
      "asset": {
        "kind": "pull_request",
        "surface": "asset",
        "success": { "statusClass": "2xx" },
        "data": {
          "number": "$.resp.iid",
          "title": "$.resp.title",
          "head_branch": "$.resp.source_branch",
          "base_branch": "$.resp.target_branch"
        },
        "fetchable": { "external": "$.resp.web_url" }
      }
    },
    {
      "grants": ["issues:read"],
      "match": { "method": "GET", "path": "/api/v4/projects/*/issues*" }
    },
    {
      "grants": ["issues:write"],
      "match": { "method": "POST", "path": "/api/v4/projects/*/issues" },
      "asset": {
        "kind": "issue",
        "surface": "asset",
        "success": { "statusClass": "2xx" },
        "data": { "iid": "$.resp.iid", "title": "$.resp.title" },
        "fetchable": { "external": "$.resp.web_url" }
      }
    },
    {
      "grants": ["pipelines:read"],
      "match": { "method": "GET", "path": "/api/v4/projects/*/pipelines*" }
    },
    {
      "grants": ["pipelines:write"],
      "match": { "method": "POST", "path": "/api/v4/projects/*/pipeline*" }
    },
    {
      "grants": ["repository:read"],
      "match": { "method": "GET", "path": "/api/v4/projects/*/repository/*" }
    },
    {
      "grants": ["repository:write"],
      "match": { "method": "POST", "path": "/api/v4/projects/*/repository/commits" }
    },
    {
      "grants": ["repository:read"],
      "match": { "method": "GET", "path": "path-query:/*.git/info/refs?service=git-upload-pack" },
      "template": "Basic {basic:oauth2}"
    },
    {
      "grants": ["repository:read"],
      "match": { "method": "POST", "path": "path-query:/*.git/git-upload-pack" },
      "template": "Basic {basic:oauth2}"
    },
    {
      "grants": ["repository:write"],
      "match": { "method": "GET", "path": "path-query:/*.git/info/refs?service=git-receive-pack" },
      "template": "Basic {basic:oauth2}"
    },
    {
      "grants": ["repository:write"],
      "match": { "method": "POST", "path": "path-query:/*.git/git-receive-pack" },
      "template": "Basic {basic:oauth2}"
    },
    {
      "grants": [
        "projects:read",
        "merge_requests:read",
        "merge_requests:write",
        "issues:read",
        "issues:write",
        "pipelines:read",
        "pipelines:write",
        "repository:read",
        "repository:write"
      ],
      "match": { "method": "GET", "path": "/api/v4/user" }
    }
  ],
  "webhook": {
    "verificationScheme": "generic_hmac_sha256",
    "events": [
      {
        "key": "merge_request.open",
        "label": "Merge request opened",
        "description": "A merge request was opened.",
        "schema": {
          "type": "object",
          "properties": {
            "object_kind": {
              "type": "string"
            },
            "user": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                }
              }
            },
            "project": {
              "type": "object",
              "properties": {
                "path_with_namespace": {
                  "type": "string"
                },
                "web_url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "object_attributes": {
              "type": "object",
              "properties": {
                "iid": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "draft": {
                  "type": "boolean"
                },
                "source_branch": {
                  "type": "string"
                },
                "target_branch": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "last_commit": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "handleCandidates": [
          {
            "parts": [
              {
                "lit": "gitlab:"
              },
              {
                "path": "project.path_with_namespace"
              },
              {
                "lit": "#"
              },
              {
                "path": "object_attributes.iid"
              }
            ]
          }
        ]
      },
      {
        "key": "merge_request.reopen",
        "label": "Merge request reopened",
