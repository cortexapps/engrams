# Coordinator
ENGRAM_BIND_ADDR=0.0.0.0:8090
ENGRAM_MODE=all                # coordinator | host | all

# Postgres
DATABASE_URL=postgres://engram:engram@localhost:5435/engram

# Cloud backend
ENGRAM_CLOUD_BACKEND=static    # gcp | static | mock

# Blob storage
ENGRAM_STORAGE_BACKEND=local   # gcs | s3 | local
ENGRAM_STORAGE_LOCAL_PATH=./var/snapshots
# ENGRAM_STORAGE_GCS_BUCKET=my-bucket
# ENGRAM_STORAGE_S3_BUCKET=my-bucket
# AWS_REGION=us-east-1

# Sandbox
ENGRAM_SANDBOX_WORK_DIR=./var/sandboxes
ENGRAM_WARM_POOL_SIZE=2

# Auth — comma-separated bearer tokens accepted on protected endpoints.
# Leave empty for local dev (auth disabled). Production must set this.
# ENGRAM_AUTH_TOKENS=
# Token the CLI sends in `Authorization: Bearer ...`. Must match one of
# the coordinator's ENGRAM_AUTH_TOKENS values.
# ENGRAM_TOKEN=

# Observability
RUST_LOG=info,engram=debug
