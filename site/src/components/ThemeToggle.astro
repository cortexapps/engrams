---
// One toggle for both the marketing pages and the docs. It writes the same
// data-theme attribute and the same localStorage key Starlight reads, so a
// choice made anywhere holds everywhere. The label and the dot are CSS-driven
// from data-theme, so there is nothing to sync after a click.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button class:list={["theme-toggle", className]} type="button" title="Toggle light / dark" data-theme-toggle>
  <span class="dot"></span>
  <span class="when-light">light</span>
  <span class="when-dark">dark</span>
</button>
<script is:inline>
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("starlight-theme", next);
      } catch {}
    });
  });
</script>
