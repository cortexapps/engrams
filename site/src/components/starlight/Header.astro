---
// The docs top bar: bottle-green, the wordmark in a cell as wide as the
// sidebar, a breadcrumb, then search and the site links.
// Replaces Starlight's Header wholesale; the mobile menu button is rendered by
// the page frame, not here.
import Search from "@astrojs/starlight/components/Search.astro";
import TraceMark from "../TraceMark.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="hd">
  <div class="hd-left">
    <a class="hd-brand" href={`${base}/`}><TraceMark size={24} />engrams</a>
    <div class="hd-crumb">
      <span class="dim">/</span><a href={`${base}/docs/`}>docs</a><span class="dim">/</span><span class="lime">v0.x</span>
    </div>
  </div>
  <div class="hd-right">
    <Search />
    <nav class="hd-links" aria-label="Site">
      <a href={`${base}/docs/`}>Docs</a>
      <a href={`${base}/`}>Home</a>
      <a href="https://github.com/cortexapps/engrams">GitHub</a>
    </nav>
  </div>
</div>
