---
// The article masthead: breadcrumb, title, description, and a meta strip with
// the read time, the page as Markdown, and the edit link. The docs home gets the hero variant instead:
// an eyebrow, the title, and the description as a lede.
// Starlight anchors the page title at #_top; the skip link and the TOC rely on it.
import { VERSION_LABEL } from "../../version";

const PAGE_TITLE_ID = "_top";

const { entry, editUrl, sidebar } = Astro.locals.starlightRoute;
const isHome = /^docs(\/index)?$/.test(entry.id);

/** The labels of the groups that lead to the current page, outermost first. */
type SidebarEntry = (typeof sidebar)[number];
function trail(entries: SidebarEntry[]): string[] | undefined {
  for (const e of entries) {
    if (e.type === "link") {
      if (e.isCurrent) return [];
      continue;
    }
    const inner = trail(e.entries);
    if (inner) return [e.label, ...inner];
  }
  return undefined;
}
const crumbs = trail(sidebar) ?? [];
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const markdown = `${base}/${entry.id}.md`;
---

{
  isHome ? (
    <div class="doc-hero">
      <div class="doc-eyebrow"><span class="pulse"></span>Documentation · {VERSION_LABEL}</div>
      <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
      {entry.data.description && <p class="doc-lede">{entry.data.description}</p>}
    </div>
  ) : (
    <div class="doc-masthead">
      <div class="doc-crumb">
        <a href={`${base}/docs/`}>docs</a>
        {crumbs.map((c) => (
          <>
            <span>/</span>
            <span>{c}</span>
          </>
        ))}
        <span>/</span>
        <span class="here">{entry.data.title}</span>
      </div>
      <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
      {entry.data.description && <p class="doc-desc">{entry.data.description}</p>}
      <div class="doc-meta">
        <span>≈ {minutes} min</span>
        <span class="doc-links">
          <a href={markdown}>markdown</a>
          <button type="button" data-copy-markdown={markdown}>copy markdown</button>
          {editUrl && (
            <a href={editUrl.href} class="edit">edit on github ↗</a>
          )}
        </span>
      </div>
    </div>
  )
}

<script>
  // Copy the page's Markdown, for pasting into an agent or a chat.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-markdown]")) {
    button.addEventListener("click", async () => {
      const label = button.textContent;
      try {
        const res = await fetch(button.dataset.copyMarkdown!);
        if (!res.ok) throw new Error(String(res.status));
        await navigator.clipboard.writeText(await res.text());
        button.textContent = "copied";
      } catch {
        button.textContent = "copy failed";
      }
      setTimeout(() => (button.textContent = label), 2000);
    });
  }
</script>
