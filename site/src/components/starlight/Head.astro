---
// Starlight's head tags, a link to the page's Markdown, then the tag manager loader.
import Default from "@astrojs/starlight/components/Head.astro";
import GoogleTagManager from "../GoogleTagManager.astro";

const { entry } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const markdown = new URL(`${base}/${entry.id}.md`, Astro.site);
---

<Default />
<link rel="alternate" type="text/markdown" href={markdown} />
<GoogleTagManager part="head" />
