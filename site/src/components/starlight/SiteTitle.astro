---
// Starlight's SiteTitle, plus the marketing routes beside it so a reader can
// get from the docs back to the landing, compare, and architecture pages.
import Default from "@astrojs/starlight/components/SiteTitle.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/docs/`, label: "Docs" },
  { href: `${base}/compare/`, label: "Compare" },
  { href: `${base}/architecture/`, label: "Architecture" },
];
---

<Default {...Astro.props}><slot /></Default>
<nav class="site-nav" aria-label="Site">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>
