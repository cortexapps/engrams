---
import TraceMark from '../TraceMark.astro';
import slack from '../../assets/connector-logos/slack.svg';
import github from '../../assets/connector-logos/github.svg';
import linear from '../../assets/connector-logos/linear.svg';
interface Props { kind: 'web' | 'slack' | 'review' | 'automation'; }
const { kind } = Astro.props;
---
<div class:list={['demo', kind]} data-scene data-step="0">
  <div class="stage">
    {kind === 'web' && <>
      <div class="app-pane">
        <div class="bar"><TraceMark size={25}/><b>engrams</b><span class="muted">/ Revenue dashboard</span></div>
        <div class="task-tabs"><span>Conversation</span><span>Files</span><span>Terminal</span></div>
        <div class="conversation">
          <div class="message prior-answer">The dashboard is running.<br/>Try it in the preview.</div>
          <div class="message human enter-one">The date filter isn’t updating the chart. Fix it.</div>
          <div class="file-edit enter-two"><span>▧</span><code>revenue-chart.tsx</code><span class="additions">+18</span><span class="deletions">−9</span><span>⌄</span></div>
          <div class="dashboard-test enter-three">✓ Date filter regression test passed</div><div class="message answer enter-three">Fixed. The chart and totals now use the selected date range.</div>
        </div>
        <div class="composer"><div>Reply to the task…</div><div class="composer-tools"><span>＋</span><span class="plan-mode">Plan</span><span class="send-key">↵</span></div></div>
      </div>
      <div class="preview paper analytics"><div class="bar"><span class="live-dot"></span> Live preview <span class="right">↗</span></div>
        <div class="analytics-nav"><b>◈ Meridian</b><span>Overview</span><span>Customers</span><span class="analytics-avatar">JD</span></div>
        <div class="analytics-body"><div class="analytics-heading"><h3>Revenue</h3><span>USD</span></div>
          <div class="date-filters" aria-label="Revenue date range"><button type="button" data-range="365" aria-pressed="false">12 months</button><button type="button" data-range="30" aria-pressed="true">Last 30 days</button><button type="button" data-range="7" aria-pressed="false">Last 7 days</button><span class="demo-pointer" aria-hidden="true">↖</span></div>
          <div class="analytics-metrics"><div><span>Total revenue</span><strong data-revenue>$0</strong></div><div><span>Transactions</span><strong data-transactions>0</strong></div></div>
          <div class="chart-heading"><b>Revenue over time</b><span data-chart-period>Sep 2025 – Sep 2026</span></div>
          <svg class="revenue-chart" viewBox="0 0 360 110" role="img" aria-label="Revenue over the displayed date range"><path class="chart-grid" d="M0 15H360M0 55H360M0 95H360"/><path data-chart-fill class="chart-fill"/><path data-chart-line class="chart-line"/></svg><div class="chart-axis"><span data-axis-start>Sep 2025</span><span data-axis-end>Sep 2026</span></div>
          <div class="transaction-title">Recent transactions <span>View all ↗</span></div><div class="transaction-row"><span class="customer-icon">N</span><div><b>Northstar Labs</b><small>Pro plan · Sep 13</small></div><span class="paid">Paid</span><b>$249.00</b></div><div class="transaction-row"><span class="customer-icon second">O</span><div><b>Orbit Studio</b><small>Team plan · Sep 12</small></div><span class="paid">Paid</span><b>$99.00</b></div>
        </div><div class="dashboard-caption"><span class="caption-before">30-day filter selected · chart still shows a year</span><span class="caption-fixed">✓ Filter fixed · try another date range</span><span class="caption-tried">✓ Seven-day view · chart and totals updated</span></div>
      </div>
    </>}
    {kind === 'slack' && <>
      <div class="slack-window paper"><div class="bar"><img src={slack.src} alt="Slack"/><b># product-eng</b><span class="right">Thread</span></div>
        <div class="slack-body"><div class="slack-message"><div class="avatar violet">M</div><div><b>Maya <small>10:42</small></b><p>The CSV export drops the last row.</p></div></div>
          <div class="slack-message enter-one"><div class="avatar blue">J</div><div><b>Jordan <small>10:43</small></b><p><mark>@engrams</mark> investigate this.</p></div></div>
          <div class="slack-message enter-two"><div class="avatar engram"><TraceMark size={27}/></div><div class="slack-reply"><b>engrams <small class="app-badge">APP</small></b><p class="working">Checking the export loop…</p><div class="enter-three"><p>The loop skips the final row.<br/>Fixed it and added a regression test.</p><div class="pr-link"><span>⑂</span><div><b>Fix ready for review ↗</b><small>#142 · Include the final CSV row</small></div></div></div></div></div>
        </div><div class="slack-compose">Reply…<span>↵</span></div>
      </div><div class="surface-note"><TraceMark size={23}/><span>Your agent. Right in the thread.</span></div>
    </>}
    {kind === 'review' && <>
      <div class="review-source paper">
        <div class="bar"><img src={github.src} alt="GitHub"/><span>acme / <b>app</b></span></div>
        <div class="github-heading"><h3>Fix CSV export <span>#142</span></h3><div class="branch-summary"><span class="pr-state">⑂ Open</span><span>into <code>main</code> from <code>fix/csv</code></span></div></div>
        <div class="github-tabs"><span>Conversation <i>2</i></span><span>Files changed <i>2</i></span></div>
        <div class="review-body"><div class="review-event"><span class="review-event-icon">⤶</span><span><b>maya</b> requested changes</span></div><div class="review-comment"><div class="review-author"><span class="avatar violet">M</span><b>maya</b><span>commented now</span><span class="comment-menu">···</span></div><p>Please cover the empty-list case.</p></div><div class="review-result enter-three"><div><span>✓</span><b>All checks have passed</b></div><span><b>engrams</b> added a commit <code>a31f82c</code></span></div></div>
      </div>
      <div class="handoff enter-one"><span>→</span><small>Review feedback<br/>automation</small></div>
      <div class="review-target"><div class="bar"><TraceMark size={25}/><b>engrams</b></div><div class="review-body"><span class="eyebrow">ORIGINAL TASK · PR #142</span><h3>Fix CSV export</h3><div class="received enter-one"><small>FROM GITHUB REVIEW</small><p>Please cover the empty-list case.</p></div><div class="agent-line review-working enter-two"><TraceMark size={23}/><span>Adding the missing test…</span></div><div class="test-result enter-three"><span>✓</span><div><b>Empty-list test added</b><small>Pushed to PR #142</small></div></div></div></div>
    </>}
    {kind === 'automation' && <>
      <div class="automation-window">
        <div class="bar"><TraceMark size={25}/><b>engrams</b><span class="muted">/ Automations</span><span class="enabled">● Enabled</span></div>
        <div class="automation-title"><div><h3>Turn bug reports into fixes</h3><p>Pick up a Linear bug. Fix it. Open a pull request.</p></div><div class="schedule-pill">Linear · Issue created · Bug</div></div>
        <div class="factory-flow">
          <div class="factory-step schedule-step"><span class="step-symbol"><img src={linear.src} alt="Linear"/></span><b>Linear bug ticket</b><small class="schedule-wait">Issue created</small><small class="schedule-fired">ENG-214 received</small></div>
          <span class="flow-wire wire-one"></span>
          <div class="factory-step agent-step"><span class="step-symbol"><TraceMark size={27}/></span><b>Fix the bug</b><small class="agent-wait">Agent session</small><small class="agent-active">Working on the fix…</small><small class="agent-done">✓ Fix verified</small></div>
          <span class="flow-wire wire-two"></span>
          <div class="factory-step output-step"><span class="step-symbol"><img src={github.src} alt="GitHub"/></span><b>Open pull request</b><small class="output-wait">After tests pass</small><small class="output-done">✓ Ready for review</small></div>
        </div>
        <div class="factory-detail"><div class="factory-idle linear-ticket"><img src={linear.src} alt="Linear"/><div><span class="detail-label">ENG-214 <span class="bug-label">Bug</span></span><b>CSV export skips the final row</b><p>Exporting 10 rows only downloads 9.</p></div></div>
          <div class="factory-work enter-one"><span class="detail-label">Working on ENG-214</span><div class="test-before">× CSV export skips the final row</div><div class="test-after enter-two">✓ 148 tests passed <span>Fix verified</span></div></div>
          <div class="factory-pr enter-three"><div class="pr-open-symbol">⑂</div><div><span class="detail-label">ENG-214 → Pull request #143</span><b>Fix the CSV export boundary</b><p>Regression test added. All checks passed.</p></div><span class="ready-pill">Review ↗</span></div>
        </div>
        <div class="factory-footer"><span class="run-pending">Listening for Linear bugs</span><span class="run-active">● Run in progress</span><span class="run-done">✓ Run complete</span><span>Ready for the next bug ticket</span></div>
      </div>
    </>}
  </div>
  <div class="transport"><button type="button" data-play aria-label="Pause animation">Pause</button><button type="button" data-replay>Replay</button><div class="timeline" aria-hidden="true"><i></i></div><button type="button" data-result>Show result</button></div>
</div>
<script>
  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene]')) {
    const play = scene.querySelector<HTMLButtonElement>('[data-play]')!;
    const progress = scene.querySelector<HTMLElement>('.timeline i')!;
    const dashboard = scene.classList.contains('web');
    const duration = dashboard ? 10500 : 8500;
    let manualRange: number | null = null;
    let lastChartKey = '';
    // Fixed daily amounts keep every range and total reproducible.
    const dailyRevenue = Array.from({length:365}, (_, i) => 180 + ((i * 73 + i * i * 11) % 640));
    const currency = new Intl.NumberFormat('en-US', {style:'currency',currency:'USD',maximumFractionDigits:0});
    const drawChart = (days: number, selected: number) => {
      const key = `${days}:${selected}`;
      if (!dashboard || key === lastChartKey) return;
      lastChartKey = key;
      const values = dailyRevenue.slice(-days);
      const bins = Math.min(days, 24);
      const sums = Array.from({length:bins}, (_, i) => values.slice(Math.floor(i*days/bins), Math.floor((i+1)*days/bins)).reduce((a,b)=>a+b,0));
      const max = Math.max(...sums) * 1.15;
      const points = sums.map((value,i)=>`${(i/(bins-1)*360).toFixed(1)},${(100-value/max*90).toFixed(1)}`);
      scene.querySelector('[data-chart-line]')!.setAttribute('d',`M${points.join(' L')}`);
      scene.querySelector('[data-chart-fill]')!.setAttribute('d',`M0,110 L${points.join(' L')} L360,110 Z`);
      scene.querySelector('[data-revenue]')!.textContent = currency.format(values.reduce((a,b)=>a+b,0));
      scene.querySelector('[data-transactions]')!.textContent = String(values.reduce((a,b)=>a+Math.ceil(b/99),0));
      const start = days === 365 ? 'Sep 2025' : days === 30 ? 'Aug 15' : 'Sep 7';
      scene.querySelector('[data-axis-start]')!.textContent = start;
      scene.querySelector('[data-chart-period]')!.textContent = `${start} – Sep 13`;
      scene.querySelector('[data-axis-end]')!.textContent = 'Sep 13';
      for (const button of scene.querySelectorAll<HTMLButtonElement>('[data-range]')) button.setAttribute('aria-pressed',String(Number(button.dataset.range)===selected));
    };
    let elapsed = 0;
    let playing = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let last = performance.now();
    const render = () => {
      scene.dataset.step = String(elapsed < 1400 ? 0 : elapsed < 3200 ? 1 : elapsed < 4700 ? 2 : 3);
      progress.style.width = `${elapsed / duration * 100}%`;
      if (dashboard) {
        const fixed = elapsed >= 4700;
        const tried = elapsed >= 7300;
        scene.dataset.tried = String(tried);
        const selected = manualRange ?? (tried ? 7 : 30);
        drawChart(fixed ? selected : 365, selected);
      }
      play.textContent = playing ? 'Pause' : 'Play';
      play.setAttribute('aria-label', playing ? 'Pause animation' : 'Play animation');
    };
    if (!playing) elapsed = 6500;
    play.addEventListener('click', () => { playing = !playing; render(); });
    scene.querySelector('[data-replay]')!.addEventListener('click', () => { elapsed = 0; manualRange = null; playing = true; render(); });
    scene.querySelector('[data-result]')!.addEventListener('click', () => { elapsed = 6500; playing = false; render(); });
    for (const button of scene.querySelectorAll<HTMLButtonElement>('[data-range]')) {
      button.addEventListener('click', () => { manualRange = Number(button.dataset.range); elapsed = 6500; playing = false; render(); });
    }
    const frame = (now: number) => {
      if (playing && !document.hidden) elapsed = (elapsed + Math.min(now - last, 100)) % duration;
      last = now; render(); requestAnimationFrame(frame);
    };
    render(); requestAnimationFrame(frame);
  }
</script>
