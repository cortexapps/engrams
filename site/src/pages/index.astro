---
import Marketing from "../layouts/Marketing.astro";
import pelican from "../assets/screenshots/session-pelican.png";
import { hero, modules, automations, how, session, extensible, belt, start } from "../landing/copy";
import { nodes, edges, glyph, frame } from "../landing/demo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = `${base}/docs/`;

const logos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/connector-logos/*.svg", { eager: true }),
)
  .map(([path, mod]) => {
    const slug = path.split("/").pop()!.replace(".svg", "");
    return { slug, src: mod.default.src, label: slug.replace(/_/g, " ") };
  })
  .sort((a, b) => a.slug.localeCompare(b.slug));
const beltItems = [...logos, ...logos];

// The first frame, so the page is complete before the script runs.
const first = frame(0, 0);
const code = (s: string) => s.replace(/`([^`]+)`/g, "<code>$1</code>");
---

<Marketing
  title="engrams · Coding agents in your cloud"
  description="engrams runs Claude Code, Codex, or your own agent in an isolated microVM on your infrastructure. Start one from a prompt, a schedule, a pull request, or a Slack thread, then inspect its changes."
  landing
>
  <!-- COVER -->
  <section class="cover">
    <div class="layer carbon bg-carbon-fade"></div>
    <div class="layer grid cont"></div>
    <div class="layer scan cont"></div>
    <div class="layer floor"></div>
    <div class="wrap">
      <div class="hero">
        <div>
          <div class="eyebrow label"><span class="pulse"></span>{hero.eyebrow}</div>
          <h1 class="display">{hero.title} <span class="lime">{hero.titleAccent}</span></h1>
          <p class="lede">{hero.lede}</p>
          <div class="actions">
            <a class="btn primary" href={docs + hero.primary.href}>{hero.primary.label}</a>
            <a class="btn outline" href={docs + hero.secondary.href}>{hero.secondary.label}</a>
          </div>
          <div class="chips">{hero.chips.map((c) => <span>{c}</span>)}</div>
        </div>
        <div class="graph-col" data-graph-col>
          <div class="graph-meta label sm">
            <span>{hero.graphTitle}</span>
            <span>Illustrative sequence</span>
          </div>
          <div class="graph-scale" data-fit="720" data-fit-spill="48">
            <div class="graph" aria-hidden="true">
              <svg width="720" height="416" viewBox="0 0 720 416" fill="none">
                {edges.map((d, i) => <path d={d} class:list={["edge", { loop: i === 6 }]} data-edge />)}
                <text x="60" y="276">LOOP ⟲</text>
              </svg>
              {nodes.map((n, i) => (
                <div class:list={["node", { active: i === 0 }]} style={`left:${n.x}px;top:${n.y}px`} data-node>
                  <div class="kind"><span>{n.kind}</span><span>{n.t}</span></div>
                  <div class="name">{n.label}</div>
                </div>
              ))}
            </div>
            <div class="runlog" data-log aria-hidden="true"><span class="cursor"></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEC. 0 — MISSION PARAMETERS -->
  <section class="sec first">
    <div class="wrap">
      <div class="sec-head"><span class="sec-badge">{modules.badge}</span><span>{modules.label}</span><span class="sec-rule"></span></div>
      <div class="modules">
        {modules.cards.map((m) => (
          <div class="hud">
            <div class="rail"></div>
            <div class="kicker"><span>{m.kicker}</span><i></i></div>
            <div class="num">{m.num}</div>
            <h3 class="display">{m.title}</h3>
            <p>{m.body}</p>
            <div class="foot">{m.foot}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SEC. 1 — A SESSION -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><span class="sec-badge">{session.badge}</span><span>{session.label}</span><span class="sec-rule"></span><span>{session.meta}</span></div>
      <h2 class="display sec-title">{session.title}</h2>
      <div class="figure">
        <figure class="plate">
          <img src={pelican.src} width={pelican.width} height={pelican.height} alt={session.screenshotAlt} loading="lazy" />
          <figcaption><span>{session.caption}</span><span class="ring">{session.live}</span></figcaption>
        </figure>
        <div>
          <p class="body">{session.body}</p>
          <div class="ledger">
            {session.panes.map((p) => (
              <div><span class="n">{p.name}</span><span>{p.body}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEC. 2 — AUTOMATIONS -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><span class="sec-badge">{automations.badge}</span><span>{automations.label}</span><span class="sec-rule"></span><span>{automations.meta}</span></div>
      <div class="sec-intro">
        <h2 class="display">{automations.title}</h2>
        <p class="lede">{automations.lede}</p>
      </div>
      <div class="cases">
        <div class="cases-head"><span class="label">{automations.cases.label}</span><span>{automations.cases.note}</span></div>
        <div class="cases-grid">
          {automations.cases.items.map((c, i) => (
            <div class="case">
              <div class="case-top"><span class="trigger">{c.trigger}</span><span class="idx">{String(i + 1).padStart(2, "0")}</span></div>
              <h3 class="display">{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="split">
        <div>
          <div class="label">{automations.board.fig}</div>
          <h3 class="display title">{automations.board.title}</h3>
          <p class="body">{automations.board.body}</p>
          <div class="label sm items-label">{automations.board.itemsLabel}</div>
          <div class="items">
            {automations.board.items.map((it) => (
              <div>
                <h3 class="display">{it.title}</h3>
                <p>{it.body}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="board" aria-label="Illustrative automation runs">
          <div class="head"><span>time</span><span>automation</span><span>trigger</span><span>duration</span><span>status</span></div>
          <div data-board-rows>
            {first.board.map((r) => (
              <div class="row">
                <span class="time">{r.time}</span>
                <span class="name">{r.name}</span>
                <span class="trigger">{r.trigger}</span>
                <span class="dur">{r.dur}</span>
                <span class:list={["status", r.status]}>{glyph[r.status]} {r.status}</span>
              </div>
            ))}
          </div>
          <div class="foot"><span data-board-count>Example runs</span><span>{automations.board.footRight}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEC. 3 — HOW IT WORKS -->
  <section class="cover how">
    <div class="layer carbon soft bg-carbon-fade"></div>
    <div class="wrap">
      <div class="sec-head"><span class="sec-badge">{how.badge}</span><span>{how.label}</span><span class="sec-rule"></span><span>{how.meta}</span></div>
      <div class="grid2">
        <div>
          <h2 class="display sec-title">{how.title}<br /><span class="lime">{how.titleAccent}</span></h2>
          <div class="steps">
            {how.steps.map((s) => (
              <div>
                <span class="s">{s.s}</span>
                <div>
                  <h3 class="display">{s.title}</h3>
                  <p set:html={code(s.body)} />
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div class="chunks" aria-hidden="true">
            <div class="cells">
              {first.chunks.map((c) => <i class={c} data-chunk></i>)}
            </div>
            <div class="meta label sm"><span>chunk store</span><span><span data-sessions>{first.sessions}</span> sessions · <span data-stored>{first.stored}</span></span></div>
          </div>
          <div class="legend">
            {how.legend.map((l) => <span><i class={l.cls} style={l.cls === "base" ? "background:rgba(255,255,255,.35)" : l.cls === "delta" ? "background:var(--primary)" : "background:var(--amber)"}></i>{l.label}</span>)}
          </div>
          <div class="leds">
            {how.leds.map((l) => (
              <div class="led">
                <div class="k">{l.k}</div>
                <div class="v"><span class="ghost" aria-hidden="true">{l.ghost}</span><span class="lit">{l.v}</span></div>
              </div>
            ))}
          </div>
          <p class="footnote">{how.footnote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEC. 4 — EXTENSIBLE -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><span class="sec-badge">{extensible.badge}</span><span>{extensible.label}</span><span class="sec-rule"></span></div>
      <div class="sec-intro">
        <h2 class="display">{extensible.title}</h2>
        <p class="lede">{extensible.lede}</p>
      </div>
      <div class="pair">
        {extensible.cards.map((c) => (
          <a class="hud wide" href={docs + c.href}>
            <div class="rail"></div>
            <div class="kicker"><span>{c.kicker}</span></div>
            <h3 class="display">{c.title}</h3>
            <p>{c.body}</p>
            <div class="foot">{c.foot}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONNECTOR BELT -->
  <section class="cover belt" aria-label="Built-in connectors">
    <div class="tag">{belt.label}</div>
    <div class="track">
      {beltItems.map((l) => (
        <div class="item"><i style={`--logo:url(${l.src})`}></i><span>{l.label}</span></div>
      ))}
    </div>
  </section>

  <!-- START -->
  <section class="cover start">
    <div class="layer carbon bg-carbon-fade"></div>
    <div class="layer scan"></div>
    <div class="wrap">
      <div class="grid2">
        <div>
          <div class="label" style="opacity:.8">{start.eyebrow}</div>
          <h2 class="display">{start.title}<span class="lime">.</span></h2>
          <p class="lede">{start.lede}</p>
        </div>
        <div class="ctas">
          {start.ctas.map((c) => (
            <a class:list={["btn", "between", c.primary ? "primary" : "outline"]} href={docs + c.href}>{c.label} <span>→</span></a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Marketing>

<script>
  import "../scripts/landing";
</script>
