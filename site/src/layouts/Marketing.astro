---
// The layout for the pages outside Starlight: /, /compare/, /architecture/.
// The header sits on the cover (bottle-green) in every theme; the page below
// it is paper unless a section says otherwise. The footer is a cover band with
// the license line and the tri-color stripe. Theme choice is stored under
// Starlight's localStorage key, so a reader who picks dark in the docs gets
// dark here too.
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/saira/wdth.css";
import "../styles/tokens.css";
import "../styles/marketing.css";
import TraceMark from "../components/TraceMark.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description: string;
  /** The landing page runs its own cover hero under the header and its own
   * Start band above the footer, so it asks the layout to leave both edges open. */
  landing?: boolean;
}
const { title, description, landing = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/engram-trace.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#081A1B" />
    <script is:inline>
      // Same key and same fallback as Starlight's ThemeProvider, run before paint.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch {}
        const theme =
          stored || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
  </head>
  <body>
    <div class:list={["cover", "masthead", { landing }]}>
      <div class="layer grid"></div>
      <div class="layer scan"></div>
      <div class="wrap">
        <div class="stripe"><span class="sage"></span><span class="amber"></span><span class="lime"></span><span></span></div>
        <header class="site-header">
          <a class="wordmark" href={`${base}/`}><TraceMark />engrams</a>
          <nav class="site-nav" aria-label="Site">
            <a class="secondary" href={`${base}/architecture/`}>Architecture</a>
            <a class="secondary" href={`${base}/compare/`}>Compare</a>
            <a href={`${base}/docs/`}>Docs</a>
            <a href="https://github.com/cortexapps/engrams">GitHub</a>
            <ThemeToggle />
            <a class="cta-small" href={`${base}/docs/getting-started/local-quickstart/`}>Run it locally</a>
          </nav>
        </header>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class:list={["cover", "site-footer", { tight: !landing }]}>
      {!landing && <div class="layer carbon bg-carbon-fade"></div>}
      {!landing && <div class="layer scan"></div>}
      <div class="wrap">
        <div class="row">
          <span>engrams · agpl-3.0</span>
          <nav aria-label="Footer">
            <a href={`${base}/architecture/`}>Architecture</a>
            <a href={`${base}/docs/`}>Docs</a>
            <a href="https://github.com/cortexapps/engrams">GitHub</a>
          </nav>
        </div>
        <div class="stripe"><span class="lime"></span><span class="amber"></span><span class="sage"></span><span></span></div>
      </div>
    </footer>
  </body>
</html>
