---
// Shared dark layout for the public marketing pages.
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/saira/wdth.css";
import "../styles/tokens.css";
import "../styles/marketing.css";
import TraceMark from "../components/TraceMark.astro";
import CortexWordmark from "../components/CortexWordmark.astro";

interface Props {
  title: string;
  description: string;
  /** The landing page runs its own cover hero under the header and its own
   * Start band above the footer, so it asks the layout to leave both edges open. */
  landing?: boolean;
}
const { title, description, landing = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
// The share card for link previews (Slack, X, LinkedIn). Without one, Slack
// scrapes the first page image, and the full-size screenshot fails to load.
const ogImage = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/engram-trace.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="engrams: the open source alternative to Devin." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#081A1B" />
  </head>
  <body>
    <div class:list={["cover", "masthead", { landing }]}>
      <div class="layer grid"></div>
      <div class="layer scan"></div>
      <div class="wrap">
        <div class="stripe"><span class="sage"></span><span class="amber"></span><span class="lime"></span><span></span></div>
        <header class="site-header">
          <div class="brand">
            <a class="wordmark" href={`${base}/`}><TraceMark />engrams</a>
            <a class="byline" href="https://www.cortex.io">by <CortexWordmark height={15} /></a>
          </div>
          <nav class="site-nav" aria-label="Site">
            <a class="secondary" href={`${base}/architecture/`}>Architecture</a>
            <a class="compare" href={`${base}/compare/`}>Compare</a>
            <a class="secondary" href={`${base}/docs/`}>Docs</a>
            <a class="gh" href="https://github.com/cortexapps/engrams" aria-label="engrams on GitHub">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              <span>GitHub</span>
            </a>
            <a class="cta-small" href={`${base}/docs/getting-started/local-quickstart/`}>Run it locally</a>
          </nav>
        </header>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class:list={["cover", "site-footer", { tight: !landing }]}>
      {!landing && <div class="layer carbon bg-carbon-fade"></div>}
      {!landing && <div class="layer scan"></div>}
      <div class="wrap">
        <div class="cortex-cta">
          <div class="pitch">
            <CortexWordmark height={22} />
            <p>Mission control for your AI software factory</p>
          </div>
          <a class="btn ghost" href="https://www.cortex.io">Visit cortex.io <span>→</span></a>
        </div>
        <div class="row">
          <span>engrams · open source</span>
          <nav aria-label="Footer">
            <a href={`${base}/architecture/`}>Architecture</a>
            <a href={`${base}/compare/`}>Compare</a>
            <a href={`${base}/docs/`}>Docs</a>
            <a href="https://github.com/cortexapps/engrams">GitHub</a>
          </nav>
        </div>
        <div class="stripe"><span class="lime"></span><span class="amber"></span><span class="sage"></span><span></span></div>
      </div>
    </footer>
  </body>
</html>
